<?php

declare(strict_types=1);

use IEdify\Core\Config;
use IEdify\Core\Database\Connection;
use IEdify\Core\Database\MigrationRunner;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\OutputInterface;

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';
$app = new Application('iEDIFY Africa', '0.1.0');
$app->add((new Command('app:doctor'))
    ->setDescription('Validate runtime, configuration, storage and database without exposing secrets')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $failed = false;
        foreach (['pdo_mysql', 'mbstring', 'intl', 'fileinfo', 'openssl', 'sodium', 'bcmath', 'dom', 'gd', 'curl', 'zip'] as $extension) {
            $ok = extension_loaded($extension);
            $failed = $failed || !$ok;
            $output->writeln(($ok ? 'OK ' : 'FAIL ') . $extension);
        }
        $output->writeln('PHP ' . PHP_VERSION);
        $failed = $failed || PHP_VERSION_ID < 80400;
        try {
            $config = Config::load($root, $input->getOption('env') === 'test');
            $config->validate();
            $pdo = Connection::open($config);
            $output->writeln('OK MySQL ' . $pdo->query('SELECT VERSION()')->fetchColumn());
            foreach (['private', 'quarantine', 'logs', 'cache', 'exports', 'sessions'] as $path) {
                if (!is_writable($root . '/storage/' . $path)) {
                    $failed = true;
                    $output->writeln('FAIL storage/' . $path);
                }
            }
            $output->writeln('Environment: ' . $config->environment());
            $output->writeln('External mail: ' . ($config->boolean('MAIL_LIVE_ENABLED') ? 'enabled' : 'disabled'));
        } catch (Throwable $error) {
            $failed = true;
            $output->writeln('FAIL configuration/database validation (' . $error::class . '). Check local configuration; credentials are not displayed.');
        }
        return $failed ? Command::FAILURE : Command::SUCCESS;
    }));
$app->add((new Command('database:migrate'))
    ->setDescription('Apply forward migrations under a database migration lock')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root, $input->getOption('env') === 'test');
        $config->validate();
        if (!in_array($config->environment(), ['local', 'test'], true)) {
            $output->writeln('Remote/production migrations require the approved release procedure.');
            return Command::FAILURE;
        }
        (new MigrationRunner($root, $config))->migrate($input, $output);
        return Command::SUCCESS;
    }));
$app->add((new Command('content:import'))
    ->setDescription('Import captured public content as review-gated drafts without changing source files')
    ->addOption('source', null, InputOption::VALUE_REQUIRED, 'Content pack directory', $root . '/iEDIFY_Website_Content_Pack')
    ->addOption('dry-run', null, InputOption::VALUE_NONE, 'Validate and reconcile without writing database records or files')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root);
        $config->validate();
        if ($config->environment() !== 'local') {
            throw new RuntimeException('Non-local content imports require the approved release procedure.');
        }
        $importer = new IEdify\Modules\CMS\Services\ContentPackImporter(Connection::open($config), $root . '/storage/private/content');
        $report = $importer->import((string) $input->getOption('source'), (bool) $input->getOption('dry-run'));
        $output->writeln(json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR));
        return Command::SUCCESS;
    }));
$app->add((new Command('content:reconcile'))
    ->setDescription('Report source URLs, destination paths, record IDs and editorial status')
    ->addOption('save', null, InputOption::VALUE_NONE, 'Save a private CSV report instead of printing JSON')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root);
        $importer = new IEdify\Modules\CMS\Services\ContentPackImporter(Connection::open($config), $root . '/storage/private/content');
        $rows = $importer->reconciliation();
        if ($input->getOption('save')) {
            $path = $root . '/storage/exports/content-reconciliation-' . gmdate('Ymd-His') . '-' . bin2hex(random_bytes(4)) . '.csv';
            $stream = fopen($path, 'xb');
            IEdify\Services\Exports\Csv::write($stream, ['source_key', 'source_url', 'destination_path', 'content_id', 'media_id', 'source_checksum', 'review_status', 'open_flags'], $rows);
            fclose($stream);
            $output->writeln('Saved ' . count($rows) . ' source mappings to ' . $path);
        } else {
            $output->writeln(json_encode($rows, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR));
        }
        return Command::SUCCESS;
    }));
$app->add((new Command('identity:seed-roles'))
    ->setDescription('Seed the role and permission matrix (idempotent)')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $pdo = Connection::open(Config::load($root, $input->getOption('env') === 'test'));
        (new IEdify\Modules\Identity\Services\RoleSeeder($pdo))->seed();
        $output->writeln('Roles and permissions seeded.');
        return Command::SUCCESS;
    }));
$app->add((new Command('identity:create-admin'))
    ->setDescription('Provision a super administrator with verified email; MFA is enforced at first sign-in')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->addOption('email', null, InputOption::VALUE_REQUIRED, 'Administrator email')
    ->addOption('name', null, InputOption::VALUE_REQUIRED, 'Administrator name')
    ->addOption('password', null, InputOption::VALUE_REQUIRED, 'Initial password (omit to be prompted)')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $helper = new Symfony\Component\Console\Helper\QuestionHelper();
        $email = $input->getOption('email');
        $name = $input->getOption('name');
        $password = $input->getOption('password');
        if (!is_string($email) || !filter_var($email, FILTER_VALIDATE_EMAIL) || !is_string($name) || trim($name) === '') {
            $output->writeln('Provide --email and --name.');
            return Command::FAILURE;
        }
        if (!is_string($password) || $password === '') {
            $question = new Symfony\Component\Console\Question\Question('Initial password (min 12 chars): ');
            $question->setHidden(true)->setHiddenFallback(false);
            $password = $helper->ask($input, $output, $question);
        }
        if (!is_string($password) || strlen($password) < 12 || strlen($password) > 72) {
            $output->writeln('Password must be 12–72 characters.');
            return Command::FAILURE;
        }
        $config = Config::load($root, $input->getOption('env') === 'test');
        $pdo = Connection::open($config);
        (new IEdify\Modules\Identity\Services\RoleSeeder($pdo))->seed();
        $identity = new IEdify\Modules\Identity\Services\IdentityService($pdo, new IEdify\Core\Security\SecretBox($config->string('APP_KEY')));
        $userId = $identity->registerAdmin(strtolower(trim($email)), trim($name), $password);
        if ($userId === null) {
            $output->writeln('An account already exists for this email.');
            return Command::FAILURE;
        }
        $output->writeln('Super administrator created (user #' . $userId . '). They must complete MFA enrollment at first sign-in.');
        return Command::SUCCESS;
    }));
$app->add((new Command('outbox:run'))
    ->setDescription('Process pending outbox events through the configured transports')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->addOption('limit', null, InputOption::VALUE_REQUIRED, 'Maximum events per run', '20')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root, $input->getOption('env') === 'test');
        $logger = new Monolog\Logger('iedify-outbox');
        $logger->pushHandler(new Monolog\Handler\StreamHandler($root . '/storage/logs/application.log', Monolog\Level::Warning, true, 0600));
        $processor = new IEdify\Core\Jobs\OutboxProcessor(Connection::open($config), $config, new IEdify\Core\Security\SecretBox($config->string('APP_KEY')), $logger, $root);
        $stats = $processor->run(max(1, (int) $input->getOption('limit')));
        $output->writeln('Processed ' . $stats['processed'] . ', failed ' . $stats['failed'] . '.');
        return $stats['failed'] > 0 ? Command::FAILURE : Command::SUCCESS;
    }));
$app->add((new Command('content:publish-scheduled'))
    ->setDescription('Publish content items whose scheduled publish_at time is due (flag/media gates still apply)')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root, $input->getOption('env') === 'test');
        $service = new IEdify\Modules\CMS\Services\CmsService(Connection::open($config));
        $count = $service->publishDueSchedules();
        $output->writeln('Published ' . $count . ' scheduled item(s).');
        return Command::SUCCESS;
    }));
$app->add((new Command('retention:purge'))
    ->setDescription('Apply data-retention policy: purge expired sessions, tokens, rate-limit buckets, old completed outbox events and read notifications')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root, $input->getOption('env') === 'test');
        $pdo = Connection::open($config);
        $outboxDays = max(7, $config->integer('RETENTION_OUTBOX_DAYS', 30));
        $notificationDays = max(7, $config->integer('RETENTION_NOTIFICATION_DAYS', 90));
        $results = [
            'sessions' => $pdo->exec('DELETE FROM sessions WHERE expires_at < UNIX_TIMESTAMP()'),
            'rate_limits' => $pdo->exec('DELETE FROM rate_limit_buckets WHERE expires_at < UTC_TIMESTAMP(6)'),
            'auth_tokens' => $pdo->exec('DELETE FROM auth_tokens WHERE consumed_at IS NOT NULL AND consumed_at < UTC_TIMESTAMP(6) - INTERVAL 7 DAY'),
            'outbox' => $pdo->exec("DELETE FROM outbox_events WHERE status = 'completed' AND processed_at < UTC_TIMESTAMP(6) - INTERVAL {$outboxDays} DAY"),
            'notifications' => $pdo->exec("DELETE FROM notifications WHERE read_at IS NOT NULL AND read_at < UTC_TIMESTAMP(6) - INTERVAL {$notificationDays} DAY"),
        ];
        foreach ($results as $scope => $count) {
            $output->writeln(sprintf('%s: %d row(s) purged', $scope, (int) $count));
        }
        return Command::SUCCESS;
    }));
$app->add((new Command('backup:create'))
    ->setDescription('Dump the whole database to a gzipped JSON-lines archive under storage/private/backups')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root, $input->getOption('env') === 'test');
        $config->validate();
        $service = new IEdify\Services\Backup\BackupService();
        $path = $service->create(Connection::open($config), $root . '/storage/private/backups');
        $output->writeln('Backup written to ' . $path . ' (' . filesize($path) . ' bytes).');
        $output->writeln('Copy it off-host now; schedule this command via cron. See docs/operations/BACKUP_RESTORE.md.');
        return Command::SUCCESS;
    }));
$app->add((new Command('backup:restore'))
    ->setDescription('Restore a backup archive into the configured database (destructive) or rehearse with a table prefix')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->addOption('file', null, InputOption::VALUE_REQUIRED, 'Backup archive path')
    ->addOption('prefix', null, InputOption::VALUE_REQUIRED, 'Table prefix for rehearsal restores (empty = real restore)', 'rehearse_')
    ->addOption('i-understand', null, InputOption::VALUE_NONE, 'Confirm a real (prefix-less) restore')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $file = $input->getOption('file');
        $prefix = (string) $input->getOption('prefix');
        if (!is_string($file) || !is_file($file)) {
            $output->writeln('Provide an existing --file.');
            return Command::FAILURE;
        }
        $config = Config::load($root, $input->getOption('env') === 'test');
        if ($prefix === '') {
            if (!$input->getOption('i-understand')) {
                $output->writeln('A real restore drops and replaces every table. Re-run with --i-understand, or use --prefix=rehearse_ for a non-destructive rehearsal.');
                return Command::FAILURE;
            }
            if (!in_array($config->environment(), ['local', 'test'], true)) {
                $output->writeln('Production restores follow the approved runbook and are not run from this command.');
                return Command::FAILURE;
            }
        }
        $count = (new IEdify\Services\Backup\BackupService())->restore(Connection::open($config), $file, $prefix);
        $output->writeln(($prefix === '' ? 'Restored' : 'Rehearsed restore into ' . $prefix . '* tables') . ': ' . $count . ' statements replayed.');
        return Command::SUCCESS;
    }));
$app->add((new Command('local:seal'))
    ->setDescription('Remove the one-use database bootstrap secret after successful local provisioning')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $local = Config::load($root);
        if ($local->environment() !== 'local' || $local->string('DB_HOST') !== '127.0.0.1' || $local->integer('DB_PORT', 3306) !== 3307) {
            throw new RuntimeException('This command only applies to the isolated local instance.');
        }
        Connection::open($local);
        Connection::open(Config::load($root, true));
        $path = $root . '/.runtime/mysql-init.sql';
        if (is_file($path) && !unlink($path)) {
            throw new RuntimeException('Could not remove the generated one-use bootstrap file.');
        }
        $output->writeln('Local bootstrap sealed. Restart MySQL without --init-file.');
        return Command::SUCCESS;
    }));
$app->add((new Command('newsletter:queue'))
    ->setDescription('Queue a newsletter broadcast to confirmed subscribers in bounded batches')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->addOption('subject', null, InputOption::VALUE_REQUIRED, 'Email subject')
    ->addOption('body-file', null, InputOption::VALUE_REQUIRED, 'Path to a UTF-8 text file with the message body')
    ->addOption('broadcast', null, InputOption::VALUE_REQUIRED, 'Existing broadcast id to continue queueing (re-run to drain the list)')
    ->addOption('limit', null, InputOption::VALUE_REQUIRED, 'Subscribers per run', '200')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root, $input->getOption('env') === 'test');
        $pdo = Connection::open($config);
        $service = new IEdify\Modules\Engagement\Services\NewsletterService($pdo, new IEdify\Core\Security\SecretBox($config->string('APP_KEY')));
        $operator = new IEdify\Core\Security\Actor(0, ['operations.manage'], true, true, true);
        $broadcast = $input->getOption('broadcast');
        if ($broadcast !== null) {
            $queued = $service->queueBroadcastBatch($operator, (int) $broadcast, (int) $input->getOption('limit'));
            $output->writeln("Queued {$queued} more message(s) for broadcast {$broadcast}.");
            return Command::SUCCESS;
        }
        $bodyFile = $input->getOption('body-file');
        $body = is_string($bodyFile) && is_file($bodyFile) ? file_get_contents($bodyFile) : false;
        if ($body === false || !is_string($input->getOption('subject'))) {
            $output->writeln('Provide --subject and --body-file.');
            return Command::FAILURE;
        }
        $result = $service->queueBroadcast($operator, (string) $input->getOption('subject'), $body, (int) $input->getOption('limit'));
        $output->writeln("Broadcast {$result['id']} queued for {$result['queued']} subscriber(s). Re-run with --broadcast={$result['id']} until it reports 0.");
        return Command::SUCCESS;
    }));
$app->add((new Command('newsletter:test-send'))
    ->setDescription('Send a newsletter broadcast preview to a single address through the configured transport')
    ->addOption('env', null, InputOption::VALUE_REQUIRED, 'Environment: configured or test')
    ->addOption('to', null, InputOption::VALUE_REQUIRED, 'Test recipient address')
    ->addOption('subject', null, InputOption::VALUE_REQUIRED, 'Email subject')
    ->addOption('body-file', null, InputOption::VALUE_REQUIRED, 'Path to a UTF-8 text file with the message body')
    ->setCode(static function (InputInterface $input, OutputInterface $output) use ($root): int {
        $config = Config::load($root, $input->getOption('env') === 'test');
        $to = $input->getOption('to');
        $bodyFile = $input->getOption('body-file');
        $body = is_string($bodyFile) && is_file($bodyFile) ? file_get_contents($bodyFile) : false;
        if (!is_string($to) || !filter_var($to, FILTER_VALIDATE_EMAIL) || $body === false || !is_string($input->getOption('subject'))) {
            $output->writeln('Provide a valid --to, --subject and --body-file.');
            return Command::FAILURE;
        }
        (new IEdify\Core\Mail\Mailer($config, $root))->send($to, '[TEST] ' . (string) $input->getOption('subject'), 'newsletter-broadcast', [
            'body' => $body,
            'unsubscribe_url' => '#test-send-no-token',
        ]);
        $output->writeln('Test send handed to the configured transport (' . $config->string('MAIL_TRANSPORT', 'capture') . ').');
        return Command::SUCCESS;
    }));
exit($app->run());
