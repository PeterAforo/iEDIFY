{
    "name": "iedify/africa",
    "description": "iEDIFY Africa public website and operational platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "monolog/monolog": "^3.9",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^7.0",
        "psr/clock": "^1.0",
        "robmorgan/phinx": "^0.16",
        "spomky-labs/otphp": "^11.3",
        "symfony/console": "^7.4",
        "symfony/html-sanitizer": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/validator": "^7.4",
        "twig/twig": "^3.22",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {"psr-4": {"IEdify\\": "app/"}},
    "autoload-dev": {"psr-4": {"IEdify\\Tests\\": "tests/"}},
    "config": {
        "sort-packages": true,
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "lint": "@php bin/lint.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:feature": "phpunit --testsuite Feature"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.3"
    }
}
