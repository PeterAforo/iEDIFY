# FTP/FTPS deployment credentials for bin/deploy-ftp.php.
# Copy to .env.deploy and fill in real values. .env.deploy is gitignored.
FTP_HOST=ftp.iedifyafrica.org
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_ROOT=/
# 1 = explicit FTPS (ftp_ssl_connect), 0 = plain FTP
FTP_SSL=1
FTP_PASSIVE=1
FTP_TIMEOUT=30
# Public site origin, used by bin/deploy-package.php to reach the extractor
DEPLOY_URL=https://iedifyafrica.org
