{% extends 'layouts/base.twig' %}
{% block title %}{{ round.title }} | iEDIFY Africa{% endblock %}
{% block content %}
<div class="container">
<h1>{{ round.title }}</h1>
<div class="prose">{{ round.description|nl2br }}</div>
<p>Opens {{ round.opens_at }} UTC · closes {{ round.closes_at }} UTC · Currency: {{ round.currency }}{% if round.max_award is not null %} · maximum award {{ round.max_award }} {{ round.currency }}{% endif %}</p>
{% if actor %}
<form method="post" action="/funding/rounds/{{ round.id }}/requests" class="stacked-form" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
    <label>Request title<input type="text" name="title" required maxlength="255"></label>
    <label>Requested amount ({{ round.currency }})<input type="number" name="amount" min="0.01" step="0.01" required></label>
    <label>Budget summary<textarea name="budget_summary" maxlength="8000"></textarea></label>
    {% for field in fields %}
        {% if field.type == 'document' %}
        <label>{{ field.label }}{% if field.required %} (required){% endif %}<input type="file" name="answers[{{ field.key }}]"{% if field.required %} required{% endif %} accept=".pdf,.png,.jpg,.jpeg"></label>
        {% elseif field.type == 'select' %}
        <label>{{ field.label }}<select name="answers[{{ field.key }}]"{% if field.required %} required{% endif %}><option value="">Choose…</option>{% for option in field.options %}<option value="{{ option }}">{{ option }}</option>{% endfor %}</select></label>
        {% elseif field.type == 'checkbox' %}
        <label><input type="checkbox" name="answers[{{ field.key }}]" value="1"> {{ field.label }}</label>
        {% else %}
        <label>{{ field.label }}<input type="{{ field.type == 'number' ? 'number' : (field.type == 'date' ? 'date' : 'text') }}" name="answers[{{ field.key }}]"{% if field.required %} required{% endif %} maxlength="4000"></label>
        {% endif %}
        {% if field.help %}<p class="field-hint">{{ field.help }}</p>{% endif %}
    {% endfor %}
    <label>Budget document (PDF/PNG/JPEG, optional)<input type="file" name="budget_document" accept=".pdf,.png,.jpg,.jpeg"></label>
    <button type="submit" class="button-secondary">Submit request</button>
</form>
{% else %}
<p><a href="/sign-in">Sign in</a> to submit a funding request.</p>
{% endif %}
</div>
{% endblock %}
