{% extends 'layouts/base.twig' %}
{% import 'public/_sections.twig' as ui %}
{% import 'partials/africa-defs.twig' as africa %}
{% set p = info.slots|default({}) %}
{% block title %}Gallery | iEDIFY Africa{% endblock %}
{% block content %}
<article class="home">

    {# ---------- Hero band ---------- #}
    <section class="about-hero" aria-labelledby="gallery-title">
        <svg class="about-hero-shape" viewBox="{{ africa.viewbox() }}" aria-hidden="true" focusable="false"><use href="#africa-shape"/></svg>
        <svg class="about-hero-dots" viewBox="{{ africa.viewbox() }}" aria-hidden="true" focusable="false"><use href="#africa-shape" fill="url(#africa-dots)"/></svg>
        <span class="float-dot dot-sun about-hero-dot-a" aria-hidden="true"></span>
        <span class="float-dot dot-leaf about-hero-dot-b" aria-hidden="true"></span>
        <div class="container about-hero-inner">
            <p class="about-eyebrow-light">{{ p.intro.heading|default('Gallery') }}</p>
            <h1 id="gallery-title" class="about-title">{{ p.intro.title|default('Moments in Focus') }}</h1>
            {% if p.intro.lead|default('') %}<p class="about-hero-lead">{{ p.intro.lead }}</p>{% endif %}
        </div>
    </section>

    {# ---------- Album collage ---------- #}
    <section class="home-section" aria-label="Event albums">
        <div class="container">
            {% if entries|default([]) %}
            {% set spans = [2, 1, 1, 1, 1, 2, 1, 1] %}
            <div class="album-collage" data-reveal-group>
                {% for entry in entries %}
                    {% if entry.type == 'quote' %}
                    <figure class="album-quote">
                        <span class="album-quote-label">{{ entry.label|default('From the field') }}</span>
                        <blockquote class="album-quote-text">{{ entry.quote.text }}</blockquote>
                        <figcaption class="album-quote-cite"><span class="album-quote-dot" aria-hidden="true"></span>{{ entry.quote.attribution }}</figcaption>
                    </figure>
                    {% else %}
                    <a class="album-card album-card--{{ spans[loop.index0 % 8] == 2 ? 'wide' : 'std' }}" href="/gallery/{{ entry.slug }}">
                        {% if entry.cover.mime starts with 'video/' %}
                        <video class="album-card-media" src="{{ entry.cover.url }}" preload="metadata" muted playsinline aria-hidden="true"></video>
                        {% else %}
                        <img class="album-card-media" src="{{ entry.cover.url }}" alt="" loading="lazy"{% if entry.cover.width and entry.cover.height %} width="{{ entry.cover.width }}" height="{{ entry.cover.height }}"{% endif %}>
                        {% endif %}
                        {% if entry.videos %}
                        <span class="album-card-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
                        {% endif %}
                        <span class="album-card-count">{{ entry.count }} {{ entry.count == 1 ? 'item' : 'items' }}</span>
                        <span class="album-card-info">
                            <span class="album-card-title">{{ entry.title }}</span>
                            <span class="album-chip">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h3l2-2h6l2 2h3v12H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                                {{ entry.photos ? entry.photos ~ ' photos' : '' }}{% if entry.photos and entry.videos %} · {% endif %}{{ entry.videos ? entry.videos ~ ' videos' : '' }}
                            </span>
                        </span>
                    </a>
                    {% endif %}
                {% endfor %}
            </div>
            {% elseif items|default([]) %}
            <div class="gallery-grid" data-reveal-group>
                {% for item in items %}
                <figure class="gallery-item">
                    {% if item.mime starts with 'video/' %}
                    <video src="/media/{{ item.id }}" controls preload="metadata" playsinline>{% if item.alt_text %}{{ item.alt_text }}{% endif %}</video>
                    {% else %}
                    <img src="/media/{{ item.id }}" alt="{{ item.alt_text }}" loading="lazy"{% if item.width and item.height %} width="{{ item.width }}" height="{{ item.height }}"{% endif %}>
                    {% endif %}
                    {% if item.alt_text %}<figcaption>{{ item.alt_text }}</figcaption>{% endif %}
                </figure>
                {% endfor %}
            </div>
            {% else %}
            <div class="card">
                <p>Photos and videos from our programs and events will appear here once they are approved for publication.</p>
                <p><a class="link-arrow" href="/news">Read the latest updates</a></p>
            </div>
            {% endif %}
        </div>
    </section>

    {% if info.leftover|default([]) %}
    <section class="home-section">
        <div class="container page-body">{{ ui.render(info.leftover, media) }}</div>
    </section>
    {% endif %}
</article>
{% endblock %}
