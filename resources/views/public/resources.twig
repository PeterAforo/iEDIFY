{% extends 'layouts/base.twig' %}
{% import 'public/_sections.twig' as ui %}
{% import 'partials/africa-defs.twig' as africa %}
{% import 'partials/icons.twig' as icons %}
{% set p = info.slots|default({}) %}
{% block title %}Resources | iEDIFY Africa{% endblock %}
{% block content %}
<article class="home">

    {# ---------- Hero band ---------- #}
    <section class="about-hero" aria-labelledby="resources-title">
        <svg class="about-hero-shape" viewBox="{{ africa.viewbox() }}" aria-hidden="true" focusable="false"><use href="#africa-shape"/></svg>
        <svg class="about-hero-dots" viewBox="{{ africa.viewbox() }}" aria-hidden="true" focusable="false"><use href="#africa-shape" fill="url(#africa-dots)"/></svg>
        <span class="float-dot dot-sun about-hero-dot-a" aria-hidden="true"></span>
        <span class="float-dot dot-leaf about-hero-dot-b" aria-hidden="true"></span>
        <div class="container about-hero-inner">
            <p class="about-eyebrow-light">{{ p.intro.heading|default('Resources') }}</p>
            <h1 id="resources-title" class="about-title">{{ p.intro.title|default('Downloads & Documents') }}</h1>
            {% if p.intro.lead|default('') %}<p class="about-hero-lead">{{ p.intro.lead }}</p>{% endif %}
        </div>
    </section>

    {# ---------- Downloadable files ---------- #}
    <section class="home-section" aria-label="Downloadable resources">
        <div class="container">
            {% if items|default([]) %}
            <div class="resource-list" data-reveal-group>
                {% for item in items %}
                <article class="resource-card">
                    <span class="resource-icon">{{ icons.icon('evidence') }}</span>
                    <div class="resource-body">
                        <h2>{{ item.alt_text|default(item.original_filename) }}</h2>
                        <p>{{ item.mime|split('/')|last|upper }} file</p>
                    </div>
                    <a class="btn-pill btn-outline" href="/media/{{ item.id }}" download>Download <span aria-hidden="true">&darr;</span></a>
                </article>
                {% endfor %}
            </div>
            {% else %}
            <div class="card">
                <p>Downloadable guides and documents will appear here as they are published. In the meantime, articles and reports live in the Publications library.</p>
                <p><a class="link-arrow" href="/publications">Browse Publications</a></p>
            </div>
            {% endif %}
        </div>
    </section>

    {% if info.leftover|default([]) %}
    <section class="home-section">
        <div class="container page-body">{{ ui.render(info.leftover, media) }}</div>
    </section>
    {% endif %}
</article>
{% endblock %}
