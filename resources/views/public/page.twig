{% extends 'layouts/base.twig' %}
{% import 'public/_sections.twig' as ui %}
{% block title %}{{ page.title }} | iEDIFY Africa{% endblock %}
{% block content %}
{% if preview is defined %}
<div class="preview-banner" role="status">Draft preview — status {{ preview.status }}, state {{ preview.state }}, revision {{ preview.revision }}. This page is not public.</div>
{% endif %}
<article class="page">
    <header class="page-header container">
        <h1>{{ page.title }}</h1>
    </header>
    <div class="container page-body">
        {{ ui.render(sections, media) }}
    </div>
    {% if roster is defined %}
    <section class="container roster" aria-label="Team roster" data-reveal-group>
        {% for member in roster %}
        <article class="roster-card">
            {% if member.portrait_asset_id and media[member.portrait_asset_id]|default(null) %}
            {% set m = media[member.portrait_asset_id] %}
            <img src="{{ m.url }}" alt="Portrait of {{ member.display_name }}" loading="lazy"{% if m.width and m.height %} width="{{ m.width }}" height="{{ m.height }}"{% endif %}>
            {% endif %}
            <div class="roster-card-body">
                <h2><a href="{{ member.slug }}">{{ member.display_name }}</a></h2>
                <p class="roster-role">{{ member.role_label }}</p>
                {% if member.youth_adviser %}<p class="roster-badge">Youth advisory board</p>{% endif %}
            </div>
        </article>
        {% endfor %}
    </section>
    {% endif %}
</article>
{% endblock %}
