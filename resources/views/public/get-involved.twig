{% extends 'layouts/base.twig' %}
{% block title %}{{ label }} | iEDIFY Africa{% endblock %}
{% block content %}
<section class="container auth-page">
    <h1>{{ label }}</h1>
    <form method="post" action="/get-involved/{{ type }}" class="stacked-form">
        <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
        <input type="text" name="fax" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="visually-hidden">
        <input type="text" name="department" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="visually-hidden">
        <label>Full name<input type="text" name="name" required maxlength="180" autocomplete="name"></label>
        <label>Email<input type="email" name="email" required maxlength="254" autocomplete="email"></label>
        <label>Tell us about yourself and how you would like to help<textarea name="background" required minlength="10" maxlength="8000"></textarea></label>
        <button type="submit" class="button-primary">Send</button>
    </form>
</section>
{% endblock %}
