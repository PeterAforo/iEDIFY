{% extends 'layouts/base.twig' %}
{% block title %}Search | iEDIFY Africa{% endblock %}
{% block content %}
<div class="container">
<h1>Search</h1>
<form method="get" action="/search" role="search" class="stacked-form">
    <label for="site-search">Search the site</label>
    <div class="search-row">
        <input id="site-search" type="search" name="q" value="{{ query }}" maxlength="120" required>
        <button type="submit" class="button-secondary">Search</button>
    </div>
</form>
{% if query is not empty %}
<p>{{ search.total }} result{{ search.total == 1 ? '' : 's' }} for “{{ query }}”.</p>
<ul class="search-results">
    {% for result in search.results %}
    <li>
        <a href="{{ result.url }}">{{ result.title }}</a> <span class="result-type">({{ result.type }})</span>
        <p>{{ result.excerpt }}</p>
    </li>
    {% else %}
    <li>No public pages, programs, events or opportunities match.</li>
    {% endfor %}
</ul>
{% if search.pages > 1 %}
<nav aria-label="Search result pages">
    {% for p in 1..search.pages %}
        {% if p == search.page %}<strong aria-current="page">{{ p }}</strong>{% else %}<a href="/search?q={{ query|url_encode }}&page={{ p }}">{{ p }}</a>{% endif %}
    {% endfor %}
</nav>
{% endif %}
{% endif %}
</div>
{% endblock %}
