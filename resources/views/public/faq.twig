{% extends 'layouts/base.twig' %}
{% block title %}Frequently asked questions | iEDIFY Africa{% endblock %}
{% block content %}
<section class="container auth-page">
    <header class="page-header">
        <h1>Frequently asked questions</h1>
        <p class="page-lead">Answers to the questions we hear most — about programs, applications, mentoring and funding.</p>
    </header>
    <form method="get" action="/faq" class="inline-form faq-search" role="search">
        <label class="visually-hidden" for="faq-q">Search questions</label>
        <input id="faq-q" type="search" name="q" value="{{ q }}" maxlength="120" placeholder="Search questions&hellip;">
        <button type="submit" class="button-secondary">Search</button>
    </form>
    <ul class="card-list faq-list">
        {% for item in items %}
        <li class="card"><h2><a href="{{ item.slug }}">{{ item.title }}</a></h2></li>
        {% else %}
        <li class="card">{% if q %}No questions matched &ldquo;{{ q }}&rdquo;.{% else %}No published questions yet.{% endif %}</li>
        {% endfor %}
    </ul>
    <p>Still stuck? <a href="/contact">Send us an enquiry</a> and the team will respond by email.</p>
</section>
{% endblock %}
