{% extends 'layouts/auth.twig' %}
{% block title %}Choose a new password | iEDIFY Africa{% endblock %}
{% block auth %}
    <h1>Choose a new password</h1>
    <form method="post" action="/password/reset/{{ token }}" class="auth-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
        <div class="field">
            <label for="password">New password</label>
            <input id="password" name="password" type="password" required autocomplete="new-password" minlength="12" aria-describedby="password-hint">
            <p id="password-hint" class="field-hint">At least 12 characters. Your other sessions will be signed out.</p>
        </div>
        <button type="submit" class="button-primary">Update password</button>
    </form>
{% endblock %}
