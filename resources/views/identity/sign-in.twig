{% extends 'layouts/auth.twig' %}
{% block title %}Sign in | iEDIFY Africa{% endblock %}
{% block auth %}
    <p class="auth-eyebrow">Member sign in</p>
    <h1>Welcome back.</h1>
    <p class="auth-lead">Pick up where you left off — programs, mentoring and opportunities are waiting for you.</p>
    <form method="post" action="/sign-in" class="auth-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
        <div class="field auth-field">
            <label for="email">Email address</label>
            <div class="auth-field-shell">
                <input id="email" name="email" type="email" required autocomplete="email" maxlength="254" value="{{ email|default('') }}">
                <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </div>
        </div>
        <div class="field auth-field">
            <div class="auth-label-row">
                <label for="password">Password</label>
                <a class="auth-forgot" href="/password/forgot">Forgot password?</a>
            </div>
            <div class="auth-field-shell auth-field-password">
                <input id="password" name="password" type="password" required autocomplete="current-password">
                <svg class="auth-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                <button type="button" class="auth-eye" data-password-toggle="password" aria-label="Show password" aria-pressed="false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z"/><circle cx="12" cy="12" r="2.8"/></svg>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden><path d="M9.9 4.9A10.5 10.5 0 0 1 12 4.5c6.5 0 10 7.5 10 7.5a17.6 17.6 0 0 1-1.9 2.8"/><path d="M6.6 6.6A17 17 0 0 0 2 12s3.5 6.5 10 6.5a10.4 10.4 0 0 0 5.4-1.5"/><path d="m3 3 18 18"/><path d="M9.9 9.9a2.8 2.8 0 0 0 4 4"/></svg>
                </button>
            </div>
        </div>
        <button type="submit" class="button-primary auth-submit">
            <span>Sign in</span>
            <svg class="auth-submit-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg>
        </button>
    </form>
    {% if signup_enabled %}<p class="auth-alt">New to iEDIFY Africa? <a href="/sign-up">Create an account</a></p>{% endif %}
{% endblock %}
