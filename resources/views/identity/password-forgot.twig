{% extends 'layouts/auth.twig' %}
{% block title %}Reset password | iEDIFY Africa{% endblock %}
{% block auth %}
    <h1>Reset your password</h1>
    <p class="auth-lead">Enter your account email and we will send a reset link.</p>
    <form method="post" action="/password/forgot" class="auth-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
        <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" required autocomplete="email" maxlength="254">
        </div>
        <button type="submit" class="button-primary">Send reset link</button>
    </form>
    <p><a href="/sign-in">Back to sign in</a></p>
{% endblock %}
