{% extends 'layouts/base.twig' %}
{% block title %}{{ opportunity.title }} | iEDIFY Africa{% endblock %}
{% block content %}
<section class="container auth-page">
    <h1>{{ opportunity.title }}</h1>
    <p><strong>Category:</strong> {{ opportunity.category }}</p>
    {% if opportunity.deadline %}<p><strong>Deadline:</strong> {{ opportunity.deadline|date('j M Y') }}</p>{% endif %}
    <div>{{ opportunity.summary|nl2br }}</div>
    {% if opportunity.details %}<div>{{ opportunity.details|nl2br }}</div>{% endif %}
    <p><a href="/opportunities">All opportunities</a></p>
</section>
{% endblock %}
