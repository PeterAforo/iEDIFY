{% extends 'layouts/base.twig' %}
{% block title %}{{ opportunity.title }} | iEDIFY Africa{% endblock %}
{% block content %}
<section class="container auth-page">
    <p><span class="pill pill-clay">{{ opportunity.category }}</span>{% if opportunity.deadline %} <span class="pill pill-ember">Deadline {{ opportunity.deadline|date('j M Y') }}</span>{% endif %}</p>
    <h1>{{ opportunity.title }}</h1>
    <div class="prose">{{ opportunity.summary|nl2br }}</div>
    {% if opportunity.details %}<div class="prose">{{ opportunity.details|nl2br }}</div>{% endif %}
    <p><a class="link-arrow" href="/opportunities">All opportunities</a></p>
</section>
{% endblock %}
