{# Duotone line icons (forest stroke + sun accent). Decorative: always aria-hidden. #}
{% macro icon(name) %}
{% set name = name|trim %}
<svg class="icon icon-{{ name }}" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{% if name == 'globe' %}
    <circle class="icon-fill" cx="30" cy="18" r="10"/>
    <circle cx="24" cy="24" r="16"/><path d="M8 24h32M24 8c5 5 7 10 7 16s-2 11-7 16c-5-5-7-10-7-16s2-11 7-16z"/>
{% elseif name == 'governance' %}
    <path class="icon-fill" d="M10 30h12l-6-10z"/>
    <path d="M24 8v32M14 40h20M10 14h28M16 14l-6 16h12zM32 14l-6 16h12z"/><path d="M10 30a6 4 0 0 0 12 0M26 30a6 4 0 0 0 12 0"/>
{% elseif name == 'evidence' %}
    <rect class="icon-fill" x="26" y="16" width="8" height="22" rx="1"/>
    <path d="M8 40h32M12 38V26h8v12M24 38V16h8v22M36 38V10"/><path d="M10 18l10-8 8 6 10-8"/>
{% elseif name == 'youth' %}
    <circle class="icon-fill" cx="31" cy="15" r="6"/>
    <circle cx="18" cy="16" r="6"/><circle cx="31" cy="15" r="5"/><path d="M6 40c0-7 5-12 12-12s12 5 12 12M26 28c1-.5 3-1 5-1 6 0 10 4 10 11"/>
{% elseif name == 'handshake' %}
    <path class="icon-fill" d="M18 26l6 6 4-4-6-6z"/>
    <path d="M4 22l8-8 8 4 8-4 8 2 8 8M12 30l8 8a3 3 0 0 0 4-4M18 36a3 3 0 0 0 4 4l2-2M26 34a3 3 0 0 0 4-4l-8-8-4 4a3 3 0 0 1-4-4l6-6"/>
{% elseif name == 'heart' %}
    <path class="icon-fill" d="M24 20c2-5 10-5 10 1 0 5-10 11-10 11s-10-6-10-11c0-6 8-6 10-1z"/>
    <path d="M24 16c3-7 15-7 15 2 0 8-15 17-15 17S9 26 9 18c0-9 12-9 15-2zM6 40h36"/>
{% elseif name == 'network' %}
    <circle class="icon-fill" cx="24" cy="24" r="6"/>
    <circle cx="24" cy="24" r="5"/><circle cx="10" cy="10" r="4"/><circle cx="38" cy="10" r="4"/><circle cx="10" cy="38" r="4"/><circle cx="38" cy="38" r="4"/><path d="M13 13l7 7M35 13l-7 7M13 35l7-7M35 35l-7-7"/>
{% elseif name == 'bulb' %}
    <circle class="icon-fill" cx="24" cy="19" r="9"/>
    <path d="M18 32c0-4-6-7-6-14a12 12 0 0 1 24 0c0 7-6 10-6 14zM19 38h10M21 43h6M24 6V2M38 10l3-3M10 10L7 7"/>
{% elseif name == 'graduate' %}
    <path class="icon-fill" d="M24 10l18 8-18 8-18-8z"/>
    <path d="M24 10l18 8-18 8-18-8zM12 21v9c0 4 6 7 12 7s12-3 12-7v-9M42 18v12"/>
{% elseif name == 'layers' %}
    <path class="icon-fill" d="M24 8l16 8-16 8-16-8z"/>
    <path d="M24 8l16 8-16 8-16-8zM8 24l16 8 16-8M8 32l16 8 16-8"/>
{% elseif name == 'voices' %}
    <path class="icon-fill" d="M26 12h14v12h-6l-4 4v-4h-4z"/>
    <path d="M8 10h22v16H18l-6 6v-6H8zM34 18h6v14h-4v5l-5-5H22v-4"/>
{% elseif name == 'pin' %}
    <circle class="icon-fill" cx="24" cy="19" r="6"/>
    <path d="M24 44s14-13 14-25a14 14 0 0 0-28 0c0 12 14 25 14 25z"/><circle cx="24" cy="19" r="5"/>
{% else %}
    <circle class="icon-fill" cx="28" cy="20" r="9"/>
    <path d="M24 6l5 11 12 1-9 8 3 12-11-6-11 6 3-12-9-8 12-1z"/>
{% endif %}
</svg>
{% endmacro %}

{# Pick an icon from the words in a card title or stat label. #}
{% macro pick(text) %}
{% set t = text|lower %}
{% if 'voice' in t or 'board' in t %}voices
{% elseif 'reach' in t or 'africa' in t or 'continent' in t %}globe
{% elseif 'govern' in t or 'transparen' in t %}governance
{% elseif 'evidence' in t or 'data' in t or 'impact' in t %}evidence
{% elseif 'youth' in t or 'under age' in t or 'people' in t or 'participant' in t %}youth
{% elseif 'stakeholder' in t or 'partner' in t %}handshake
{% elseif 'volunteer' in t %}heart
{% elseif 'associate' in t or 'network' in t %}network
{% elseif 'alumni' in t or 'education' in t %}graduate
{% elseif 'pillar' in t %}layers
{% elseif 'innovation' in t or 'idea' in t %}bulb
{% else %}star{% endif %}
{% endmacro %}
