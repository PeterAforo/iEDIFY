{% extends 'layouts/admin.twig' %}
{% block title %}Studio | iEDIFY Africa{% endblock %}
{% block page_title %}Studio{% endblock %}
{% block admin %}
<div class="studio-masthead">
    <div class="studio-greeting">{{ greeting }}.</div>
    <div class="studio-date">{{ "now"|date('l, j F Y') }} — here's what the site needs today.</div>
</div>
{% if counts.flags > 0 or counts.media_pending > 0 %}
<div class="row g-3 mb-4">
    {% if counts.flags > 0 %}
    <div class="col-md-6">
        <a href="/admin/flags" class="text-decoration-none">
            <div class="card attention-card h-100"><div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-flag fs-3 text-warning"></i>
                <div><div class="fw-semibold">{{ counts.flags }} editorial flag{{ counts.flags == 1 ? '' : 's' }} need{{ counts.flags == 1 ? 's' : '' }} review</div><div class="small text-body-secondary">Imported content waiting for a decision.</div></div>
                <i class="bi bi-arrow-right ms-auto"></i>
            </div></div>
        </a>
    </div>
    {% endif %}
    {% if counts.media_pending > 0 %}
    <div class="col-md-6">
        <a href="/admin/media" class="text-decoration-none">
            <div class="card attention-card h-100"><div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-images fs-3 text-warning"></i>
                <div><div class="fw-semibold">{{ counts.media_pending }} media asset{{ counts.media_pending == 1 ? '' : 's' }} awaiting approval</div><div class="small text-body-secondary">Images and files can't go public until approved.</div></div>
                <i class="bi bi-arrow-right ms-auto"></i>
            </div></div>
        </a>
    </div>
    {% endif %}
</div>
{% else %}
<div class="card attention-card attention-ok mb-4"><div class="card-body d-flex align-items-center gap-3 py-3">
    <i class="bi bi-check-circle fs-4 text-success"></i>
    <div class="small"><strong>All clear.</strong> No open flags or pending media approvals.</div>
</div></div>
{% endif %}
{% set published = counts.content|filter(r => r.status == 'published')|first %}
<div class="row g-3 mb-4 desk-kpis">
    <div class="col-sm-6 col-xl-3">
        <a href="/admin/content?status=published" class="text-decoration-none">
            <div class="small-box"><span class="small-box-icon"><i class="bi bi-file-earmark-text"></i></span>
                <div class="inner"><h3>{{ published.total|default(0) }}</h3><p>Published items</p></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/admin/team" class="text-decoration-none">
            <div class="small-box"><span class="small-box-icon"><i class="bi bi-people"></i></span>
                <div class="inner"><h3>{{ counts.team }}</h3><p>Team members</p></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/admin/media" class="text-decoration-none">
            <div class="small-box"><span class="small-box-icon"><i class="bi bi-images"></i></span>
                <div class="inner"><h3>{{ counts.media_total }}</h3><p>Media assets{% if counts.media_pending > 0 %} · {{ counts.media_pending }} pending{% endif %}</p></div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/admin/applications" class="text-decoration-none">
            <div class="small-box"><span class="small-box-icon"><i class="bi bi-inbox"></i></span>
                <div class="inner"><h3>{{ counts.applications_open }}</h3><p>Open applications</p></div>
            </div>
        </a>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title">Recently edited</h3></div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    {% for item in recent %}
                    <a href="/admin/content/{{ item.id }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2">
                        <div class="flex-grow-1">
                            <div class="fw-semibold">{{ item.title }}</div>
                            <div class="small text-body-secondary">{{ item.slug }}</div>
                        </div>
                        <span class="status-pill status-{{ item.status }}">{{ item.status }}</span>
                        <span class="text-body-secondary small text-nowrap">{{ item.updated_at|date('j M') }}</span>
                    </a>
                    {% else %}
                    <div class="list-group-item text-body-secondary text-center py-4">No content yet.</div>
                    {% endfor %}
                </div>
            </div>
            <div class="card-footer"><a href="/admin/content" class="text-decoration-none small fw-semibold">All content <i class="bi bi-arrow-right"></i></a></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Create</h3></div>
            <div class="card-body d-grid gap-2">
                <a href="/admin/content/new?type=page" class="btn btn-outline-primary text-start"><i class="bi bi-file-earmark-plus me-2"></i>New page</a>
                <a href="/admin/content/new?type=news" class="btn btn-outline-primary text-start"><i class="bi bi-newspaper me-2"></i>New news article</a>
                <a href="/admin/content/new?type=faq" class="btn btn-outline-primary text-start"><i class="bi bi-question-circle me-2"></i>New FAQ</a>
                <a href="/admin/team/new" class="btn btn-outline-primary text-start"><i class="bi bi-person-plus me-2"></i>New team member</a>
                <a href="/admin/media" class="btn btn-outline-primary text-start"><i class="bi bi-upload me-2"></i>Upload media</a>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h3 class="card-title">At a glance</h3></div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    {% for row in counts.content %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><span class="status-pill status-{{ row.status }} me-2">{{ row.status }}</span></span>
                        <span class="fw-semibold desk-num">{{ row.total }}</span>
                    </li>
                    {% endfor %}
                    {% if counts.outbox_pending > 0 %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="text-body-secondary">Queued mail</span>
                        <span class="fw-semibold">{{ counts.outbox_pending }}</span>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
