{% extends 'layouts/admin.twig' %}
{% block title %}Administration | iEDIFY Africa{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block admin %}
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-primary">
            <div class="inner">
                <h3>{{ counts.content|map(r => r.total)|reduce((a, b) => a + b, 0) }}</h3>
                <p>Content items</p>
            </div>
            <i class="small-box-icon bi bi-file-earmark-text"></i>
            <a href="/admin/content" class="small-box-footer">Manage content <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-warning">
            <div class="inner">
                <h3>{{ counts.flags }}</h3>
                <p>Open review flags</p>
            </div>
            <i class="small-box-icon bi bi-flag"></i>
            <a href="/admin/flags" class="small-box-footer">Review flags <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-info">
            <div class="inner">
                <h3>{{ counts.media_pending }}</h3>
                <p>Pending media</p>
            </div>
            <i class="small-box-icon bi bi-images"></i>
            <a href="/admin/media" class="small-box-footer">Review media <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-secondary">
            <div class="inner">
                <h3>{{ counts.outbox_pending }}</h3>
                <p>Queued mail</p>
            </div>
            <i class="small-box-icon bi bi-send"></i>
            <a href="/admin/outbox" class="small-box-footer">View outbox <i class="bi bi-arrow-right-circle"></i></a>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Content by status</h3></div>
    <div class="card-body">
        <ul class="list-group list-group-flush">
            {% for row in counts.content %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                {{ row.status }}<span class="badge text-bg-primary rounded-pill">{{ row.total }}</span>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}
