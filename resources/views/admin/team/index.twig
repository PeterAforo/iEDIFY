{% extends 'layouts/admin.twig' %}
{% block title %}Team | iEDIFY Africa{% endblock %}
{% block page_title %}Team members{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="/admin/content">Content</a></li><li class="breadcrumb-item active" aria-current="page">Team</li>{% endblock %}
{% block admin %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-body-secondary mb-0">Members appear on the public <a href="/team" target="_blank" rel="noopener">team page</a> in the order below.</p>
    <a href="/admin/team/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add member</a>
</div>
{% for group, members in groups %}
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">{{ group_labels[group]|default(group) }}</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap mb-0">
            <thead><tr><th>Order</th><th>Name</th><th>Role</th><th>Portrait</th><th>Bio page</th><th></th></tr></thead>
            <tbody>
                {% for m in members %}
                <tr>
                    <td class="text-body-secondary">{{ m.display_order }}</td>
                    <td>
                        <a href="/admin/team/{{ m.id }}"><strong>{{ m.display_name }}</strong></a>
                        {% if m.youth_adviser %}<span class="badge text-bg-info ms-1">Youth adviser</span>{% endif %}
                        {% if m.status != 'published' %}<span class="badge text-bg-warning ms-1">{{ m.status }}</span>{% endif %}
                    </td>
                    <td>{{ m.role_label }}</td>
                    <td>{% if m.portrait_asset_id %}<span class="badge text-bg-success">{{ m.portrait_name|default('set') }}</span>{% else %}<span class="text-body-secondary">none</span>{% endif %}</td>
                    <td><code>{{ m.slug }}</code></td>
                    <td class="text-end">
                        <a href="/admin/team/{{ m.id }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
                        <a href="{{ m.slug }}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm" title="View public page"><i class="bi bi-box-arrow-up-right"></i></a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="card"><div class="card-body text-center text-body-secondary py-5">No team members yet. <a href="/admin/team/new">Add the first member</a>.</div></div>
{% endfor %}
{% endblock %}
