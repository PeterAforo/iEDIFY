{% extends 'layouts/admin.twig' %}
{% block title %}Applications | iEDIFY Africa{% endblock %}
{% block page_title %}Applications{% endblock %}
{% block admin %}
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/admin/applications" class="row g-3 align-items-end">
            <div class="col-auto">
                <label for="a-status" class="form-label">Status</label>
                <select id="a-status" name="status" class="form-select">
                    <option value="">All</option>
                    {% for s in ['submitted','screening','under_review','shortlisted','waitlisted','request_info','accepted','rejected','withdrawn','enrolled'] %}<option value="{{ s }}"{% if status == s %} selected{% endif %}>{{ s|replace({'_': ' '}) }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Filter</button></div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Applicant</th><th scope="col">Program</th><th scope="col">Intake</th><th scope="col">Status</th><th scope="col">Submitted (UTC)</th></tr></thead>
            <tbody>
                {% for application in applications %}
                <tr>
                    <td><a href="/admin/applications/{{ application.id }}">{{ application.email }}</a></td>
                    <td>{{ application.program_title }}</td>
                    <td>{{ application.intake_name }}</td>
                    <td><span class="badge text-bg-{{ application.status in ['accepted','enrolled'] ? 'success' : (application.status == 'rejected' ? 'danger' : 'secondary') }}">{{ application.status|replace({'_': ' '}) }}</span></td>
                    <td>{{ application.submitted_at ?? '—' }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No applications match.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
