{% extends 'layouts/admin.twig' %}
{% block title %}Milestone review | iEDIFY Africa{% endblock %}
{% block page_title %}Milestone review{% endblock %}
{% block admin %}
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Awaiting review</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Title</th><th scope="col">Owner</th><th scope="col">Startup</th><th scope="col">Evidence</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for milestone in submitted %}
                <tr>
                    <td>{{ milestone.title }}</td>
                    <td>{{ milestone.owner_name ?? '—' }}</td>
                    <td>{{ milestone.startup_name ?? '—' }}</td>
                    <td>{{ milestone.evidence ?? '' }}</td>
                    <td>
                        <form method="post" action="/admin/milestones/{{ milestone.id }}/review" class="d-flex gap-2">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <input type="hidden" name="version" value="{{ milestone.version }}">
                            <button type="submit" name="decision" value="approved" class="btn btn-success btn-sm">Approve</button>
                            <button type="submit" name="decision" value="changes_requested" class="btn btn-outline-warning btn-sm">Request changes</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">Nothing awaiting review.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Overdue</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Title</th><th scope="col">Owner</th><th scope="col">Startup</th><th scope="col">Due</th><th scope="col">Status</th></tr></thead>
            <tbody>
                {% for milestone in overdue %}
                <tr>
                    <td>{{ milestone.title }}</td>
                    <td>{{ milestone.owner_name ?? '—' }}</td>
                    <td>{{ milestone.startup_name ?? '—' }}</td>
                    <td>{{ milestone.due_on|date('j M Y') }}</td>
                    <td><span class="badge text-bg-danger">{{ milestone.status|replace({'_': ' '}) }}</span></td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No overdue milestones.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
