{% extends 'layouts/admin.twig' %}
{% block title %}{{ course.title }} | iEDIFY Africa{% endblock %}
{% block page_title %}{{ course.title }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="/admin/learning">Learning</a></li><li class="breadcrumb-item active" aria-current="page">{{ course.title }}</li>{% endblock %}
{% block admin %}
<p class="text-body-secondary">Status: <span class="badge text-bg-{{ course.status == 'published' ? 'success' : 'secondary' }}">{{ course.status }}</span></p>
<div class="card mb-4 desk-mw-36">
    <div class="card-body">
        <form method="post" action="/admin/courses/{{ course.id }}/status" class="row g-2 align-items-center">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-auto">
                <select name="status" class="form-select" aria-label="Course status">
                    {% for s in ['draft','published','archived'] %}<option value="{{ s }}"{% if course.status == s %} selected{% endif %}>{{ s }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Update status</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Lessons</h3></div>
    <div class="card-body">
        <ol class="mb-0">
            {% for lesson in course.lessons %}<li>{{ lesson.title }}{% if lesson.external_url %} — <a href="{{ lesson.external_url }}" rel="noopener noreferrer">resource</a>{% endif %}</li>{% else %}<li class="text-body-secondary">No lessons yet.</li>{% endfor %}
        </ol>
    </div>
    <div class="card-body border-top">
        <h4 class="fs-6 fw-bold">Add lesson</h4>
        <form method="post" action="/admin/courses/{{ course.id }}/lessons" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-3"><label class="form-label">Position<input type="number" name="position" min="1" max="500" required class="form-control"></label></div>
            <div class="col-md-9"><label class="form-label">Title<input type="text" name="title" required maxlength="255" class="form-control"></label></div>
            <div class="col-12"><label class="form-label">Body<textarea name="body" maxlength="50000" class="form-control"></textarea></label></div>
            <div class="col-12"><label class="form-label">External URL (https)<input type="url" name="external_url" class="form-control"></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Save lesson</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Sessions</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Label</th><th scope="col">When (UTC)</th><th scope="col">Recorded</th></tr></thead>
            <tbody>
                {% for session in sessions %}
                <tr><td>{{ session.label }}</td><td>{{ session.session_at }}</td><td>{{ session.recorded }}</td></tr>
                {% else %}
                <tr><td colspan="3" class="text-center text-body-secondary">No sessions scheduled.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <form method="post" action="/admin/courses/{{ course.id }}/sessions" class="row g-2 align-items-end">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-auto"><label class="form-label">Label<input type="text" name="label" required maxlength="255" class="form-control"></label></div>
            <div class="col-auto"><label class="form-label">When (UTC)<input type="datetime-local" name="session_at" required class="form-control"></label></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Add session</button></div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Enrolled participants</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Status</th><th scope="col">Attendance</th></tr></thead>
            <tbody>
                {% for row in enrolled %}
                <tr>
                    <td>{{ row.name }}</td>
                    <td>{{ row.email }}</td>
                    <td>{{ row.status }}</td>
                    <td>
                        {% if sessions %}
                        <form method="post" action="/admin/sessions/{{ sessions[0].id }}/attendance" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <input type="hidden" name="user_id" value="{{ row.user_id }}">
                            <select name="status" class="form-select form-select-sm w-auto" aria-label="Attendance">
                                {% for s in ['present','absent','excused'] %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
                            </select>
                            <button type="submit" class="btn btn-outline-primary btn-sm">Record for latest session</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-body-secondary">No enrollments yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <form method="post" action="/admin/courses/{{ course.id }}/enroll" class="row g-2 align-items-end">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-auto"><label class="form-label">User ID<input type="number" name="user_id" required min="1" class="form-control"></label></div>
            <div class="col-auto"><label class="form-label">Cohort ID (optional)<input type="number" name="cohort_id" min="0" class="form-control"></label></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Enroll participant</button></div>
        </form>
    </div>
</div>
<p class="mt-3"><a href="/admin/learning">Back to learning</a></p>
{% endblock %}
