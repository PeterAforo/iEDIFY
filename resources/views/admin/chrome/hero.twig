{% extends 'layouts/admin.twig' %}
{% block title %}Hero slides | iEDIFY Africa{% endblock %}
{% block page_title %}Hero slides{% endblock %}
{% block admin %}
<p class="text-body-secondary small">Slides render on the home page in sort order. Images must be approved public media (see the media library for IDs).</p>
<div class="card mb-4">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover align-middle">
            <thead><tr><th scope="col">Title</th><th scope="col">Kicker</th><th scope="col">Media</th><th scope="col">CTA</th><th scope="col">Sort</th><th scope="col">Enabled</th><th scope="col"></th><th scope="col"></th></tr></thead>
            <tbody>
                {% for slide in slides %}
                <tr>
                    <td><input type="text" name="title" value="{{ slide.title }}" required maxlength="255" class="form-control form-control-sm" form="hero-{{ slide.id }}"></td>
                    <td><input type="text" name="kicker" value="{{ slide.kicker }}" maxlength="255" class="form-control form-control-sm" form="hero-{{ slide.id }}"></td>
                    <td><input type="number" name="media_id" value="{{ slide.media_id }}" min="0" class="form-control form-control-sm" style="width:6rem" form="hero-{{ slide.id }}"></td>
                    <td>
                        <input type="text" name="cta_label" value="{{ slide.cta_label }}" maxlength="80" placeholder="Label" class="form-control form-control-sm mb-1" form="hero-{{ slide.id }}">
                        <input type="text" name="cta_url" value="{{ slide.cta_url }}" maxlength="500" placeholder="/path" class="form-control form-control-sm" form="hero-{{ slide.id }}">
                    </td>
                    <td><input type="number" name="sort" value="{{ slide.sort }}" min="0" max="999" class="form-control form-control-sm" style="width:5rem" form="hero-{{ slide.id }}"></td>
                    <td class="text-center"><input type="checkbox" name="enabled" value="1" class="form-check-input"{% if slide.enabled %} checked{% endif %} form="hero-{{ slide.id }}"></td>
                    <td>
                        <form id="hero-{{ slide.id }}" method="post" action="/admin/hero">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <input type="hidden" name="id" value="{{ slide.id }}">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Save</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" action="/admin/hero/delete">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <input type="hidden" name="id" value="{{ slide.id }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="text-center text-body-secondary">No slides yet — the page-level hero section is used.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Add slide</h3></div>
    <form method="post" action="/admin/hero">
        <div class="card-body">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="mb-3"><label class="form-label">Title<input type="text" name="title" required maxlength="255" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">Kicker<input type="text" name="kicker" maxlength="255" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">Body<textarea name="body" maxlength="4000" class="form-control"></textarea></label></div>
            <div class="row">
                <div class="col-md-6 mb-3"><label class="form-label">CTA label<input type="text" name="cta_label" maxlength="80" class="form-control"></label></div>
                <div class="col-md-6 mb-3"><label class="form-label">CTA URL (site-relative)<input type="text" name="cta_url" maxlength="500" class="form-control" placeholder="/get-involved/participant"></label></div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3"><label class="form-label">Media ID (optional)<input type="number" name="media_id" min="0" class="form-control"></label></div>
                <div class="col-md-4 mb-3"><label class="form-label">Sort<input type="number" name="sort" value="10" min="0" max="999" class="form-control"></label></div>
                <div class="col-md-4 mb-3 d-flex align-items-end"><div class="form-check"><input type="checkbox" name="enabled" value="1" class="form-check-input" checked id="hero-enabled"><label class="form-check-label" for="hero-enabled">Enabled</label></div></div>
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Add slide</button></div>
    </form>
</div>
{% endblock %}
