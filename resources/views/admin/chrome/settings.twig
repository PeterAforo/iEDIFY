{% extends 'layouts/admin.twig' %}
{% block title %}Site settings | iEDIFY Africa{% endblock %}
{% block page_title %}Site settings{% endblock %}
{% block admin %}
<div class="card" style="max-width:48rem">
    <div class="card-header"><h3 class="card-title">Contact &amp; social</h3></div>
    <form method="post" action="/admin/settings">
        <div class="card-body">
            <p class="text-body-secondary small">Contact details and social links shown in the site footer. Secrets and provider credentials are never editable here — they live in server environment configuration only.</p>
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="mb-3"><label class="form-label">Contact email<input type="email" name="settings[contact_email]" value="{{ settings.contact_email }}" maxlength="254" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">Contact phone<input type="text" name="settings[contact_phone]" value="{{ settings.contact_phone }}" maxlength="120" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">Contact address<input type="text" name="settings[contact_address]" value="{{ settings.contact_address }}" maxlength="500" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">Twitter / X URL<input type="url" name="settings[social_twitter]" value="{{ settings.social_twitter }}" maxlength="500" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">LinkedIn URL<input type="url" name="settings[social_linkedin]" value="{{ settings.social_linkedin }}" maxlength="500" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">Facebook URL<input type="url" name="settings[social_facebook]" value="{{ settings.social_facebook }}" maxlength="500" class="form-control"></label></div>
            <div class="mb-3"><label class="form-label">Instagram URL<input type="url" name="settings[social_instagram]" value="{{ settings.social_instagram }}" maxlength="500" class="form-control"></label></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Save settings</button></div>
    </form>
</div>
{% endblock %}
