{% extends 'layouts/admin.twig' %}
{% block title %}Impact | iEDIFY Africa{% endblock %}
{% block page_title %}Impact measurement{% endblock %}
{% block extra_head %}<script type="module" src="{{ asset('resources/assets/scripts/charts.js') }}"></script>{% endblock %}
{% block admin %}
<p><a class="btn btn-outline-primary" href="/admin/impact/export.csv"><i class="bi bi-download me-1"></i>Download results CSV</a></p>
{% if charts %}
<div class="row mb-4">
    {% for chart in charts %}
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Published actuals vs targets ({{ chart.unit }})</h3></div>
            <div class="card-body">
                <canvas data-chart="{{ chart.config|json_encode|e('html_attr') }}" role="img" aria-label="Bar chart of published actuals versus targets; tables below contain the same figures."></canvas>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Results dashboard</h3></div>
    <div class="card-body">
        <form method="get" action="/admin/impact" class="row g-3 align-items-end">
            <div class="col-auto"><label class="form-label">Status<select name="status" class="form-select"><option value="">All</option>{% for s in ['submitted','verified','published','rejected'] %}<option value="{{ s }}"{% if filters.status == s %} selected{% endif %}>{{ s }}</option>{% endfor %}</select></label></div>
            <div class="col-auto"><label class="form-label">Period<input type="text" name="period" value="{{ filters.period }}" placeholder="2026" pattern="\d{4}(-\d{2})?" class="form-control"></label></div>
            <div class="col-auto"><label class="form-label">Geography<input type="text" name="geography" value="{{ filters.geography }}" maxlength="120" class="form-control"></label></div>
            <div class="col-auto"><label class="form-label">Program<select name="program_id" class="form-select"><option value="0">All</option>{% for p in programs %}<option value="{{ p.id }}"{% if filters.program_id == p.id %} selected{% endif %}>{{ p.title }}</option>{% endfor %}</select></label></div>
            <div class="col-auto"><label class="form-label">Cohort<select name="cohort_id" class="form-select"><option value="0">All</option>{% for c in cohorts %}<option value="{{ c.id }}"{% if filters.cohort_id == c.id %} selected{% endif %}>{{ c.name }}</option>{% endfor %}</select></label></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Filter</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Indicator dictionary</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Unit</th><th scope="col">Frequency</th><th scope="col">Status</th><th scope="col">Set target</th></tr></thead>
            <tbody>
                {% for indicator in indicators %}
                <tr>
                    <td><code>{{ indicator.code }}</code></td>
                    <td>{{ indicator.name }}</td>
                    <td>{{ indicator.unit }}</td>
                    <td>{{ indicator.frequency }}</td>
                    <td><span class="badge text-bg-{{ indicator.status == 'active' ? 'success' : 'secondary' }}">{{ indicator.status }}</span></td>
                    <td>
                        <form method="post" action="/admin/impact/indicators/{{ indicator.id }}/targets" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <input type="text" name="period" pattern="\d{4}(-\d{2})?" placeholder="2026" size="7" required class="form-control form-control-sm" aria-label="Period" style="width:6rem">
                            <input type="number" name="target" min="0" step="any" required class="form-control form-control-sm" aria-label="Target" style="width:7rem">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Save</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-body-secondary">No indicators yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <h4 class="fs-6 fw-bold">New indicator</h4>
        <form method="post" action="/admin/impact/indicators" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-4"><label class="form-label">Code (UPPER_SNAKE)<input type="text" name="code" required pattern="[A-Z][A-Z0-9_]+" maxlength="40" class="form-control"></label></div>
            <div class="col-md-8"><label class="form-label">Name<input type="text" name="name" required maxlength="180" class="form-control"></label></div>
            <div class="col-12"><label class="form-label">Definition<textarea name="definition" required class="form-control"></textarea></label></div>
            <div class="col-md-3"><label class="form-label">Unit<input type="text" name="unit" required maxlength="60" placeholder="people, startups, USD, %" class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Source<input type="text" name="source" maxlength="120" value="operational" class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Calculation<input type="text" name="calculation" maxlength="255" class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Frequency<select name="frequency" class="form-select"><option value="monthly">monthly</option><option value="quarterly">quarterly</option><option value="annual" selected>annual</option></select></label></div>
            <div class="col-12"><label class="form-label">Validation method<textarea name="validation" class="form-control"></textarea></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Create indicator</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Results</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Indicator</th><th scope="col">Period</th><th scope="col">Geography</th><th scope="col">Value</th><th scope="col">Status</th><th scope="col">Submitted by</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for result in results %}
                <tr>
                    <td>{{ result.code }} — {{ result.indicator_name }}</td>
                    <td>{{ result.period }}</td>
                    <td>{{ result.geography|default('—') }}</td>
                    <td>{{ result.value }} {{ result.unit }}</td>
                    <td><span class="badge text-bg-{{ result.status == 'published' ? 'success' : (result.status == 'rejected' ? 'danger' : 'secondary') }}">{{ result.status }}</span></td>
                    <td>{{ result.submitted_by_name|default('—') }}</td>
                    <td class="d-flex gap-2">
                        {% if result.status == 'submitted' %}
                        <form method="post" action="/admin/impact/results/{{ result.id }}/verify"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="hidden" name="version" value="{{ result.version }}"><button type="submit" class="btn btn-outline-primary btn-sm">Verify</button></form>
                        {% endif %}
                        {% if result.status == 'verified' %}
                        <form method="post" action="/admin/impact/results/{{ result.id }}/publish"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="hidden" name="version" value="{{ result.version }}"><button type="submit" class="btn btn-outline-success btn-sm">Publish</button></form>
                        {% endif %}
                        {% if result.status in ['submitted','verified'] %}
                        <form method="post" action="/admin/impact/results/{{ result.id }}/reject"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="hidden" name="version" value="{{ result.version }}"><button type="submit" class="btn btn-outline-danger btn-sm">Reject</button></form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-body-secondary">No results yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <h4 class="fs-6 fw-bold">Submit a result</h4>
        <form method="post" action="/admin/impact/results" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-6"><label class="form-label">Indicator
                <select name="indicator_id" required class="form-select">
                    {% for indicator in indicators if indicator.status == 'active' %}<option value="{{ indicator.id }}">{{ indicator.code }} — {{ indicator.name }}</option>{% endfor %}
                </select>
            </label></div>
            <div class="col-md-3"><label class="form-label">Period<input type="text" name="period" pattern="\d{4}(-\d{2})?" placeholder="2026 or 2026-03" required class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Value<input type="number" name="value" min="0" step="any" required class="form-control"></label></div>
            <div class="col-md-4"><label class="form-label">Geography<input type="text" name="geography" maxlength="120" class="form-control"></label></div>
            <div class="col-md-4"><label class="form-label">Disaggregation (JSON, optional)<input type="text" name="disaggregation" placeholder='{"sex":"female"}' maxlength="500" class="form-control"></label></div>
            <div class="col-md-4"><label class="form-label">Group size (required when disaggregated)<input type="number" name="group_size" min="0" class="form-control"></label></div>
            <div class="col-12"><label class="form-label">Source / evidence note<textarea name="source_note" class="form-control"></textarea></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Submit for verification</button></div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Reports</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Title</th><th scope="col">Period</th><th scope="col">Status</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for report in reports %}
                <tr>
                    <td>{{ report.title }}</td>
                    <td>{{ report.period }}</td>
                    <td><span class="badge text-bg-{{ report.status == 'published' ? 'success' : (report.status == 'approved' ? 'info' : 'secondary') }}">{{ report.status }}</span></td>
                    <td>
                        {% if report.status == 'draft' %}
                        <form method="post" action="/admin/impact/reports/{{ report.id }}/approve"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="hidden" name="version" value="{{ report.version }}"><button type="submit" class="btn btn-outline-primary btn-sm">Approve</button></form>
                        {% elseif report.status == 'approved' %}
                        <form method="post" action="/admin/impact/reports/{{ report.id }}/publish"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="hidden" name="version" value="{{ report.version }}"><button type="submit" class="btn btn-outline-success btn-sm">Publish</button></form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-body-secondary">No reports yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <h4 class="fs-6 fw-bold">New report</h4>
        <form method="post" action="/admin/impact/reports" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-8"><label class="form-label">Title<input type="text" name="title" required maxlength="255" class="form-control"></label></div>
            <div class="col-md-4"><label class="form-label">Period<input type="text" name="period" pattern="\d{4}(-\d{2})?" required class="form-control" placeholder="2026"></label></div>
            <div class="col-12"><label class="form-label">Summary<textarea name="summary" required class="form-control"></textarea></label></div>
            <div class="col-12"><label class="form-label">Body<textarea name="body" rows="8" required class="form-control"></textarea></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Draft report</button></div>
        </form>
    </div>
</div>
{% endblock %}
