{% extends 'layouts/admin.twig' %}
{% block title %}Review flags | iEDIFY Africa{% endblock %}
{% block page_title %}Review flags{% endblock %}
{% block admin %}
<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>Open flags block publication until a reviewer resolves them.
</div>
<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Flag</th><th scope="col">Message</th><th scope="col">Source</th><th scope="col">Content</th><th scope="col">Action</th></tr></thead>
            <tbody>
                {% for flag in flags %}
                <tr>
                    <td><code>{{ flag.code }}</code></td>
                    <td class="text-wrap">{{ flag.message }}</td>
                    <td><code>{{ flag.source_key }}</code></td>
                    <td>{% if flag.content_id %}<a href="/admin/content/{{ flag.content_id }}">{{ flag.content_title }}</a>{% else %}—{% endif %}</td>
                    <td>
                        <form method="post" action="/admin/flags/{{ flag.id }}/resolve">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Resolve</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No open flags.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
