{% extends 'layouts/admin.twig' %}
{% block title %}Data requests | iEDIFY Africa{% endblock %}
{% block page_title %}Data requests{% endblock %}
{% block admin %}
<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">User</th><th scope="col">Type</th><th scope="col">Requested</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for request in requests %}
                <tr>
                    <td>{{ request.name }}<br><small class="text-body-secondary">{{ request.email }}</small></td>
                    <td>{{ request.type }}</td>
                    <td>{{ request.requested_at }}</td>
                    <td>
                        <form method="post" action="/admin/requests/{{ request.id }}" class="d-flex gap-2">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <button type="submit" name="decision" value="completed" class="btn btn-outline-success btn-sm">Mark completed</button>
                            <button type="submit" name="decision" value="rejected" class="btn btn-outline-danger btn-sm">Reject</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-body-secondary">No pending requests.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<p class="text-body-secondary small mt-3">Completing a deletion request deactivates the account. Export fulfilment is manual: compile the user's records, deliver them securely, then mark the request completed. Audit and financial records are retained per policy.</p>
{% endblock %}
