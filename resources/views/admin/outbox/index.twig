{% extends 'layouts/admin.twig' %}
{% block title %}Outbox | iEDIFY Africa{% endblock %}
{% block page_title %}Message outbox{% endblock %}
{% block admin %}
<div class="mb-3">
    {% for status, count in counts %}<span class="badge text-bg-secondary me-1">{{ status }}: {{ count }}</span>{% endfor %}
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Pending and failed events</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Event</th><th scope="col">Status</th><th scope="col">Attempts</th><th scope="col">Last error</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for event in events %}
                <tr>
                    <td>{{ event.event_type }}<br><small class="text-body-secondary">{{ event.event_key }}</small></td>
                    <td><span class="badge text-bg-{{ event.status == 'failed' ? 'danger' : 'warning' }}">{{ event.status }}</span></td>
                    <td>{{ event.attempts }}</td>
                    <td>{{ event.last_error_code }}</td>
                    <td>
                        {% if event.status == 'failed' %}
                        <form method="post" action="/admin/outbox/{{ event.id }}/retry">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Re-queue</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No pending or failed events.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
