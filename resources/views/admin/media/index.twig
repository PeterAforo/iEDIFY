{% extends 'layouts/admin.twig' %}
{% block title %}Media | iEDIFY Africa{% endblock %}
{% block admin %}
<h1>Media review</h1>
<nav class="filter-tabs" aria-label="Filter media by status">
    {% for s in ['pending','approved','rejected'] %}<a href="/admin/media?status={{ s }}"{% if status == s %} aria-current="page"{% endif %}>{{ s }}</a>{% endfor %}
</nav>
<div class="media-grid">
    {% for asset in assets %}
    <figure class="media-card">
        <img src="/media/{{ asset.id }}" alt="{{ asset.alt_text }}" loading="lazy">
        <figcaption>
            <p><strong>{{ asset.original_filename }}</strong></p>
            <p>{{ asset.mime }}{% if asset.width %} · {{ asset.width }}×{{ asset.height }}{% endif %} · {{ asset.review_status }}</p>
            <p>{{ asset.alt_text }}</p>
            {% if asset.review_status == 'pending' %}
            <div class="action-row">
                <form method="post" action="/admin/media/{{ asset.id }}/review">
                    <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                    <input type="hidden" name="decision" value="approved">
                    <button type="submit" class="button-primary">Approve</button>
                </form>
                <form method="post" action="/admin/media/{{ asset.id }}/review">
                    <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                    <input type="hidden" name="decision" value="rejected">
                    <button type="submit" class="button-secondary">Reject</button>
                </form>
            </div>
            {% endif %}
        </figcaption>
    </figure>
    {% else %}
    <p>No media in this state.</p>
    {% endfor %}
</div>
{% endblock %}
