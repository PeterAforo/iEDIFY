{% extends 'layouts/admin.twig' %}
{% block title %}{{ page_heading|default('Content') }} | iEDIFY Africa{% endblock %}
{% block page_eyebrow %}Content{% endblock %}
{% block page_title %}{{ page_heading|default('All content') }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ page_heading|default('All content') }}</li>{% endblock %}
{% block admin %}
{% set all_total = status_counts|reduce((a, b) => a + b, 0) %}
<ul class="nav desk-tabs flex-wrap">
    <li class="nav-item"><a class="nav-link{% if filters.status == '' %} active{% endif %}" href="/admin/content{% if filters.type %}?type={{ filters.type }}{% endif %}">All <span class="badge text-bg-secondary ms-1">{{ all_total }}</span></a></li>
    <li class="nav-item"><a class="nav-link{% if filters.status == 'published' %} active{% endif %}" href="/admin/content?status=published{% if filters.type %}&type={{ filters.type }}{% endif %}">Published <span class="badge text-bg-secondary ms-1">{{ status_counts.published|default(0) }}</span></a></li>
    <li class="nav-item"><a class="nav-link{% if filters.status == 'draft' %} active{% endif %}" href="/admin/content?status=draft{% if filters.type %}&type={{ filters.type }}{% endif %}">Drafts <span class="badge text-bg-secondary ms-1">{{ status_counts.draft|default(0) }}</span></a></li>
    <li class="nav-item"><a class="nav-link{% if filters.status == 'review' %} active{% endif %}" href="/admin/content?status=review{% if filters.type %}&type={{ filters.type }}{% endif %}">In review <span class="badge text-bg-secondary ms-1">{{ status_counts.review|default(0) }}</span></a></li>
    <li class="nav-item"><a class="nav-link{% if filters.status == 'archived' %} active{% endif %}" href="/admin/content?status=archived{% if filters.type %}&type={{ filters.type }}{% endif %}">Archived <span class="badge text-bg-secondary ms-1">{{ status_counts.archived|default(0) }}</span></a></li>
    <li class="nav-item ms-auto">
        <a href="/admin/content/new{% if filters.type in creatable_types %}?type={{ filters.type }}{% endif %}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add new</a>
    </li>
</ul>
<div class="card">
    <div class="card-body border-bottom">
        <form method="get" action="/admin/content" class="row g-2 align-items-end">
            {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}
            <div class="col-auto">
                <label for="f-type" class="form-label mb-1">Type</label>
                <select id="f-type" name="type" class="form-select form-select-sm">
                    <option value="">All types</option>
                    {% for t, label in type_labels %}<option value="{{ t }}"{% if filters.type == t %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label for="f-q" class="form-label mb-1">Search</label>
                <input id="f-q" name="q" type="search" maxlength="120" class="form-control form-control-sm" value="{{ filters.q }}" placeholder="Title or URL…">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
        </form>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap mb-0">
            <thead><tr><th scope="col">Title</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Flags</th><th scope="col">Updated</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for item in items %}
                <tr>
                    <td>
                        <a href="/admin/content/{{ item.id }}"><strong>{{ item.title }}</strong></a>
                        <div class="small"><code>{{ item.slug }}</code></div>
                    </td>
                    <td>{{ type_labels[item.content_type]|default(item.content_type) }}</td>
                    <td>
                        <span class="status-pill status-{{ item.status }}">{{ item.status }}</span>
                        {% if item.working_state != 'approved' and item.status != 'archived' %}<span class="badge text-bg-light border">{{ item.working_state }}</span>{% endif %}
                    </td>
                    <td>{% if item.open_flags > 0 %}<span class="badge text-bg-danger">{{ item.open_flags }} open</span>{% else %}<span class="text-body-secondary">—</span>{% endif %}</td>
                    <td class="text-body-secondary">{{ item.updated_at|date('j M Y') }}</td>
                    <td class="text-end">
                        <a href="/admin/content/{{ item.id }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
                        {% if item.status == 'published' %}<a href="{{ item.slug }}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm" title="View live"><i class="bi bi-box-arrow-up-right"></i></a>{% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-body-secondary py-5">
                    <div class="fw-semibold mb-1">Nothing here yet</div>
                    <div class="small mb-3">No content matches the current view.</div>
                    <a href="/admin/content/new{% if filters.type in creatable_types %}?type={{ filters.type }}{% endif %}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Create something</a>
                </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
