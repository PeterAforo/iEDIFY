{% extends 'layouts/admin.twig' %}
{% block title %}Content | iEDIFY Africa{% endblock %}
{% block page_title %}Content{% endblock %}
{% block admin %}
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/admin/content" class="row g-3 align-items-end">
            <div class="col-auto">
                <label for="f-status" class="form-label">Status</label>
                <select id="f-status" name="status" class="form-select">
                    <option value="">All</option>
                    {% for s in ['draft','review','published','archived'] %}<option value="{{ s }}"{% if filters.status == s %} selected{% endif %}>{{ s }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label for="f-type" class="form-label">Type</label>
                <select id="f-type" name="type" class="form-select">
                    <option value="">All</option>
                    {% for t in ['page','legal','team','program','pillar','news','story','faq','event','opportunity','publication','hero','auth_copy'] %}<option value="{{ t }}"{% if filters.type == t %} selected{% endif %}>{{ t }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label for="f-q" class="form-label">Search</label>
                <input id="f-q" name="q" type="search" maxlength="120" class="form-control" value="{{ filters.q }}">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Title</th><th scope="col">Slug</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Draft state</th><th scope="col">Flags</th><th scope="col">Updated (UTC)</th></tr></thead>
            <tbody>
                {% for item in items %}
                <tr>
                    <td><a href="/admin/content/{{ item.id }}">{{ item.title }}</a></td>
                    <td><code>{{ item.slug }}</code></td>
                    <td>{{ item.content_type }}</td>
                    <td><span class="badge text-bg-{{ item.status == 'published' ? 'success' : (item.status == 'review' ? 'warning' : 'secondary') }}">{{ item.status }}</span></td>
                    <td>{{ item.working_state }}</td>
                    <td>{% if item.open_flags > 0 %}<span class="badge text-bg-danger">{{ item.open_flags }} open</span>{% else %}—{% endif %}</td>
                    <td>{{ item.updated_at }}</td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-body-secondary">No content matches the current filters.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
