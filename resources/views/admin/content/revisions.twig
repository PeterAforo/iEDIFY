{% extends 'layouts/admin.twig' %}
{% block title %}Revisions for {{ item.title }} | iEDIFY Africa{% endblock %}
{% block page_title %}Revisions{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="/admin/content">Content</a></li><li class="breadcrumb-item"><a href="/admin/content/{{ item.id }}">{{ item.title }}</a></li><li class="breadcrumb-item active" aria-current="page">Revisions</li>{% endblock %}
{% block admin %}
<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Revision</th><th scope="col">Title</th><th scope="col">Author</th><th scope="col">Created (UTC)</th><th scope="col">Live</th><th scope="col">Action</th></tr></thead>
            <tbody>
                {% for revision in revisions %}
                <tr>
                    <td>{{ revision.revision_number }}</td>
                    <td>{{ revision.title }}</td>
                    <td>{{ revision.author|default('Import') }}</td>
                    <td>{{ revision.created_at }}</td>
                    <td>{% if revision.is_live %}<span class="badge text-bg-success">Live</span>{% endif %}</td>
                    <td>
                        {% if can_restore %}
                        <form method="post" action="/admin/content/{{ item.id }}/revisions/{{ revision.revision_number }}/restore">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <input type="hidden" name="version" value="{{ item.version }}">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Restore as draft</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<p class="mt-3"><a href="/admin/content/{{ item.id }}">Back to editor</a></p>
{% endblock %}
