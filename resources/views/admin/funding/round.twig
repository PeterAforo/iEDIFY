{% extends 'layouts/admin.twig' %}
{% block title %}{{ round.title }} | iEDIFY Africa{% endblock %}
{% block page_title %}{{ round.title }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="/admin/funding">Funding</a></li><li class="breadcrumb-item active" aria-current="page">{{ round.title }}</li>{% endblock %}
{% block admin %}
<p class="text-body-secondary">Status: <span class="badge text-bg-{{ round.status == 'open' ? 'success' : 'secondary' }}">{{ round.status }}</span> · Currency: {{ round.currency }}{% if round.max_award is not null %} · Max award: {{ round.max_award }} {{ round.currency }}{% endif %}</p>
<div class="card mb-4" style="max-width:36rem">
    <div class="card-body">
        <form method="post" action="/admin/funding/rounds/{{ round.id }}/status" class="row g-2 align-items-center">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <input type="hidden" name="version" value="{{ round.version }}">
            <div class="col-auto">
                <select name="status" class="form-select" aria-label="Round status">
                    {% for s in ['draft','open','closed','archived'] %}<option value="{{ s }}"{% if round.status == s %} selected{% endif %}>{{ s }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Update status</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Scoring rule versions</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Version</th><th scope="col">Criteria</th><th scope="col">Max score</th><th scope="col">Created</th></tr></thead>
            <tbody>
                {% for rule in rules %}
                <tr>
                    <td>v{{ rule.version }}</td>
                    <td><code>{{ rule.weights_json }}</code></td>
                    <td>{{ rule.max_score }}</td>
                    <td>{{ rule.created_at }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-body-secondary">No rule versions yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <h4 class="fs-6 fw-bold">New rule version</h4>
        <form method="post" action="/admin/funding/rounds/{{ round.id }}/rules" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-8"><label class="form-label">Criteria — one per line as <code>criterion=weight</code> (weights 1–100)<textarea name="criteria_lines" rows="4" placeholder="impact=40&#10;feasibility=35&#10;team=25" required class="form-control font-monospace"></textarea></label></div>
            <div class="col-md-4"><label class="form-label">Max score per criterion<input type="number" name="max_score" min="1" max="10" value="5" class="form-control"></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Save rule version</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Custom request form</h3></div>
    <form method="post" action="/admin/funding/rounds/{{ round.id }}/form">
        <div class="card-body">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="mb-3"><label class="form-label">Fields (JSON array of {key, label, type, required, options, help}; types: text, number, date, select, checkbox, document)<textarea name="fields" rows="6" class="form-control font-monospace" placeholder='[{"key":"stage","label":"Venture stage","type":"select","required":true,"options":["idea","early","growth"]}]'>{{ round.form_schema }}</textarea></label></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Save request form</button></div>
    </form>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Requests</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Request</th><th scope="col">Applicant</th><th scope="col">Amount</th><th scope="col">Status</th><th scope="col">Submitted</th></tr></thead>
            <tbody>
                {% for request in requests %}
                <tr>
                    <td><a href="/admin/funding/requests/{{ request.id }}">{{ request.title }}</a></td>
                    <td>{{ request.applicant_name }}</td>
                    <td>{{ request.requested_amount }} {{ request.currency }}</td>
                    <td>{{ request.status }}</td>
                    <td>{{ request.submitted_at }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No requests in this round.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
