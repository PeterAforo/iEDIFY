{% extends 'layouts/admin.twig' %}
{% block title %}{{ request.title }} | iEDIFY Africa{% endblock %}
{% block page_title %}{{ request.title }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="/admin/funding">Funding</a></li><li class="breadcrumb-item active" aria-current="page">{{ request.title }}</li>{% endblock %}
{% block admin %}
<p class="text-body-secondary">Status: <span class="badge text-bg-{{ request.status == 'approved' ? 'success' : (request.status == 'rejected' ? 'danger' : 'secondary') }}">{{ request.status }}</span> · Requested: {{ request.requested_amount }} {{ request.currency }} · Rule version: v{{ request.rules.version|default('?') }} (frozen at submission)</p>
{% if request.budget_summary %}
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Budget summary</h3></div>
    <div class="card-body">{{ request.budget_summary|nl2br }}</div>
</div>
{% endif %}
{% if request.budget_media_id %}<p><a href="/media/{{ request.budget_media_id }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-download me-1"></i>Download budget document</a></p>{% endif %}
{% if request.answers %}
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Form answers</h3></div>
    <div class="card-body">
        <dl class="row mb-0">
            {% for key, value in request.answers %}<dt class="col-sm-4">{{ key }}</dt><dd class="col-sm-8">{{ value is same as(true) ? 'Yes' : (value is same as(false) ? 'No' : value) }}</dd>{% endfor %}
        </dl>
    </div>
</div>
{% endif %}
{% if request.rules %}
<div class="card mb-4" style="max-width:40rem">
    <div class="card-header"><h3 class="card-title">Scorecard (v{{ request.rules.version }}, max {{ request.rules.max_score }})</h3></div>
    <form method="post" action="/admin/funding/requests/{{ request.id }}/reviews">
        <div class="card-body">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            {% for criterion, weight in request.rules.weights %}
            <div class="mb-3"><label class="form-label">{{ criterion }} (weight {{ weight }}, 0–{{ request.rules.max_score }})<input type="number" name="scores[{{ criterion }}]" min="0" max="{{ request.rules.max_score }}" step="0.5" required class="form-control"></label></div>
            {% endfor %}
            <div class="mb-3"><label class="form-label">Recommendation
                <select name="recommendation" class="form-select"><option value="award">award</option><option value="decline">decline</option><option value="hold">hold</option></select>
            </label></div>
            <div class="mb-3"><label class="form-label">Notes<textarea name="notes" maxlength="8000" class="form-control"></textarea></label></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Record review</button></div>
    </form>
</div>
{% endif %}
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Reviews</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Reviewer</th><th scope="col">Weighted total</th><th scope="col">Recommendation</th><th scope="col">Notes</th></tr></thead>
            <tbody>
                {% for review in request.reviews %}
                <tr><td>{{ review.reviewer_name }}</td><td>{{ review.weighted_total }}</td><td>{{ review.recommendation }}</td><td>{{ review.notes }}</td></tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-body-secondary">No reviews yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Conflicts of interest</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Reviewer</th><th scope="col">Declaration</th><th scope="col">Status</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for conflict in request.conflicts %}
                <tr>
                    <td>{{ conflict.reviewer_name }}</td><td>{{ conflict.declaration }}</td><td>{{ conflict.status }}</td>
                    <td>{% if conflict.status == 'declared' %}<form method="post" action="/admin/funding/conflicts/{{ conflict.id }}/clear"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><button type="submit" class="btn btn-outline-primary btn-sm">Clear</button></form>{% endif %}</td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-body-secondary">No conflicts declared.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <form method="post" action="/admin/funding/requests/{{ request.id }}/conflicts" class="row g-2 align-items-end">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col"><label class="form-label">Declare a conflict<textarea name="declaration" maxlength="2000" class="form-control" rows="1"></textarea></label></div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-warning">Declare</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Decision</h3></div>
    <div class="card-body">
        {% if request.approval %}
        <p class="mb-0">{{ request.approval.decision }} by {{ request.approver_name }}{% if request.approval.reason %} — {{ request.approval.reason }}{% endif %}</p>
        {% else %}
        <form method="post" action="/admin/funding/requests/{{ request.id }}/decision" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <input type="text" name="reason" maxlength="1000" class="form-control" placeholder="Reason" aria-label="Decision reason">
            <button type="submit" name="decision" value="approved" class="btn btn-success">Approve</button>
            <button type="submit" name="decision" value="rejected" class="btn btn-outline-danger">Reject</button>
        </form>
        {% endif %}
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Award</h3></div>
    <div class="card-body">
        {% if request.award %}
        <p>Awarded: {{ request.award.amount }} {{ request.award.currency }}{% if request.award.conditions %} — {{ request.award.conditions }}{% endif %} (<span class="badge text-bg-secondary">{{ request.award.status }}</span>)</p>
        <h4 class="fs-6 fw-bold">Disbursements</h4>
        <div class="table-responsive">
            <table class="table table-hover text-nowrap">
                <thead><tr><th scope="col">Reference</th><th scope="col">Scheduled</th><th scope="col">Amount</th><th scope="col">Status</th><th scope="col"></th></tr></thead>
                <tbody>
                    {% for d in request.disbursements %}
                    <tr>
                        <td>{{ d.reference }}</td><td>{{ d.scheduled_on }}</td><td>{{ d.amount }} {{ d.currency }}</td><td>{{ d.status }}</td>
                        <td class="d-flex gap-2">
                            {% if d.status == 'planned' %}
                            <form method="post" action="/admin/funding/disbursements/{{ d.id }}/authorize"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><button type="submit" class="btn btn-outline-primary btn-sm">Authorize</button></form>
                            <form method="post" action="/admin/funding/disbursements/{{ d.id }}/cancel"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button></form>
                            {% elseif d.status == 'authorized' %}
                            <form method="post" action="/admin/funding/disbursements/{{ d.id }}/record" class="d-flex gap-2 align-items-center"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="text" name="note" maxlength="1000" class="form-control form-control-sm" placeholder="Note" aria-label="Disbursement note"><button type="submit" class="btn btn-outline-primary btn-sm">Record</button></form>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="text-center text-body-secondary">No disbursements scheduled.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <h4 class="fs-6 fw-bold mt-3">Schedule disbursement</h4>
        <form method="post" action="/admin/funding/awards/{{ request.award.id }}/disbursements" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-4"><label class="form-label">Transfer reference<input type="text" name="reference" required maxlength="120" class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Scheduled date<input type="date" name="scheduled_on" required class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Amount ({{ request.award.currency }})<input type="number" name="amount" min="0.01" step="0.01" required class="form-control"></label></div>
            <div class="col-md-6"><label class="form-label">Note<input type="text" name="note" maxlength="1000" class="form-control"></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Schedule disbursement</button></div>
        </form>
        {% elseif request.status == 'approved' %}
        <form method="post" action="/admin/funding/requests/{{ request.id }}/award" class="row g-3" style="max-width:40rem">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-6"><label class="form-label">Award amount ({{ request.currency }})<input type="number" name="amount" min="0.01" max="{{ request.requested_amount }}" step="0.01" required class="form-control"></label></div>
            <div class="col-12"><label class="form-label">Conditions<textarea name="conditions" maxlength="8000" class="form-control"></textarea></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Record award</button></div>
        </form>
        {% else %}
        <p class="text-body-secondary mb-0">Awards are recorded after an approval.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
