{% extends 'layouts/admin.twig' %}
{% block title %}Invitations | iEDIFY Africa{% endblock %}
{% block page_title %}Staff invitations{% endblock %}
{% block admin %}
<div class="card mb-4" style="max-width:48rem">
    <div class="card-body">
        <form method="post" action="/admin/invitations" class="row g-3 align-items-end">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-auto"><label class="form-label">Email<input type="email" name="email" required maxlength="254" class="form-control"></label></div>
            <div class="col-auto"><label class="form-label">Role
                <select name="role_id" class="form-select">
                    {% for role in roles %}<option value="{{ role.id }}">{{ role.name }}</option>{% endfor %}
                </select>
            </label></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Send invitation</button></div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Pending invitations</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Invited by</th><th scope="col">Expires (UTC)</th></tr></thead>
            <tbody>
                {% for invite in invitations %}
                <tr>
                    <td>{{ invite.email }}</td>
                    <td>{{ invite.role_name }}</td>
                    <td>{{ invite.invited_by_name }}</td>
                    <td>{{ invite.expires_at }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-body-secondary">No pending invitations.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
