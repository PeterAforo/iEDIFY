{% extends 'layouts/admin.twig' %}
{% block title %}{{ org.name }} | iEDIFY Africa{% endblock %}
{% block page_title %}{{ org.name }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item"><a href="/admin/partners">Partners</a></li><li class="breadcrumb-item active" aria-current="page">{{ org.name }}</li>{% endblock %}
{% block admin %}
<p class="text-body-secondary">{{ org.org_type }} · <span class="badge text-bg-{{ org.status == 'active' ? 'success' : 'secondary' }}">{{ org.status }}</span>{% if org.website %} · <a href="{{ org.website }}" rel="noopener noreferrer">{{ org.website }}</a>{% endif %}</p>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Members</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for member in org.members %}
                <tr>
                    <td>{{ member.name }}</td><td>{{ member.email }}</td><td>{{ member.member_role }}</td><td>{{ member.status }}</td>
                    <td>{% if member.status == 'active' %}<form method="post" action="/admin/partners/{{ org.id }}/members/{{ member.user_id }}/suspend"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><button type="submit" class="btn btn-outline-warning btn-sm">Suspend</button></form>{% endif %}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No members.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <form method="post" action="/admin/partners/{{ org.id }}/members" class="row g-2 align-items-end">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-auto"><label class="form-label">User email<input type="email" name="email" required class="form-control"></label></div>
            <div class="col-auto"><label class="form-label">Role<select name="member_role" class="form-select"><option value="viewer">viewer</option><option value="admin">admin</option></select></label></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Add member</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Proposals</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Title</th><th scope="col">Status</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for proposal in org.proposals %}
                <tr>
                    <td>{{ proposal.title }}</td><td>{{ proposal.status }}</td>
                    <td>
                        <form method="post" action="/admin/partners/proposals/{{ proposal.id }}/status" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="hidden" name="version" value="{{ proposal.version }}">
                            <select name="status" class="form-select form-select-sm w-auto" aria-label="Proposal status">{% for s in ['draft','submitted','under_review','committed','declined','withdrawn'] %}<option value="{{ s }}"{% if proposal.status == s %} selected{% endif %}>{{ s }}</option>{% endfor %}</select>
                            <button type="submit" class="btn btn-outline-primary btn-sm">Update</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="3" class="text-center text-body-secondary">No proposals.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <form method="post" action="/admin/partners/{{ org.id }}/proposals" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-6"><label class="form-label">Proposal title<input type="text" name="title" required maxlength="255" class="form-control"></label></div>
            <div class="col-12"><label class="form-label">Summary<textarea name="summary" required class="form-control" rows="2"></textarea></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Draft proposal</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Commitments &amp; funds received</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Date</th><th scope="col">Commitment</th><th scope="col">Received</th><th scope="col">Status</th><th scope="col">Record receipt</th></tr></thead>
            <tbody>
                {% for c in org.commitments %}
                <tr>
                    <td>{{ c.committed_on }}</td>
                    <td>{{ c.amount }} {{ c.currency }}</td>
                    <td>{{ c.received_total }} {{ c.currency }}</td>
                    <td>{{ c.status }}</td>
                    <td>
                        <form method="post" action="/admin/partners/commitments/{{ c.id }}/received" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                            <input type="text" name="reference" size="10" required class="form-control form-control-sm" placeholder="Ref" aria-label="Reference" style="width:7rem">
                            <input type="number" name="amount" min="0.01" step="0.01" size="10" required class="form-control form-control-sm" placeholder="Amount" aria-label="Amount" style="width:7rem">
                            <input type="date" name="received_on" required class="form-control form-control-sm" aria-label="Received on" style="width:9rem">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Record</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No commitments.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <div class="alert alert-warning small"><strong>Commitments are pledges, not received funds.</strong> Receipts: {% for r in org.received %}{{ r.reference }} {{ r.amount }} {{ r.currency }} ({{ r.received_on }}){% if not loop.last %}, {% endif %}{% else %}none yet{% endfor %}.</div>
        <form method="post" action="/admin/partners/{{ org.id }}/commitments" class="row g-3">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-3"><label class="form-label">Amount<input type="number" name="amount" min="0.01" step="0.01" required class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Currency<input type="text" name="currency" pattern="[A-Z]{3}" maxlength="3" value="USD" required class="form-control"></label></div>
            <div class="col-md-3"><label class="form-label">Committed on<input type="date" name="committed_on" required class="form-control"></label></div>
            <div class="col-12"><label class="form-label">Conditions<textarea name="conditions" class="form-control" rows="2"></textarea></label></div>
            <div class="col-md-6"><label class="form-label">Linked proposal (optional)<select name="proposal_id" class="form-select"><option value="">—</option>{% for p in org.proposals %}<option value="{{ p.id }}">{{ p.title }}</option>{% endfor %}</select></label></div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Record commitment</button></div>
        </form>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><h3 class="card-title">Shared resources</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Type</th><th scope="col">ID</th><th scope="col">Shared</th><th scope="col">Revoked</th><th scope="col"></th></tr></thead>
            <tbody>
                {% for share in org.shares %}
                <tr>
                    <td>{{ share.resource_type }}</td><td>{{ share.resource_id }}</td><td>{{ share.shared_at }}</td><td>{{ share.revoked_at|default('—') }}</td>
                    <td>{% if share.revoked_at is null %}<form method="post" action="/admin/partners/{{ org.id }}/shares/revoke"><input type="hidden" name="_csrf" value="{{ csrf.token() }}"><input type="hidden" name="resource_type" value="{{ share.resource_type }}"><input type="hidden" name="resource_id" value="{{ share.resource_id }}"><button type="submit" class="btn btn-outline-danger btn-sm">Revoke</button></form>{% endif %}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">Nothing shared yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <form method="post" action="/admin/partners/{{ org.id }}/shares" class="row g-3 align-items-end">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col-md-4"><label class="form-label">Resource type
                <select name="resource_type" required class="form-select">
                    <option value="report">published impact report</option>
                    <option value="document">private document (media ID)</option>
                    <option value="project">program</option>
                </select>
            </label></div>
            <div class="col-md-3"><label class="form-label">Resource ID<input type="number" name="resource_id" min="1" required class="form-control"></label></div>
            <div class="col-12">
                <p class="form-text">Published reports: {% for r in reports %}#{{ r.id }} {{ r.title }}{% if not loop.last %}, {% endfor %}. Programs: {% for p in programs %}#{{ p.id }} {{ p.title }}{% if not loop.last %}, {% endfor %}.</p>
            </div>
            <div class="col-12"><button type="submit" class="btn btn-primary">Share</button></div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3 class="card-title">Staff relationship notes <small class="text-body-secondary">(never shown to the partner)</small></h3></div>
    <div class="card-body">
        {% for note in org.notes %}
        <div class="border-bottom pb-2 mb-2"><strong>{{ note.author|default('Staff') }}</strong> <span class="text-body-secondary small">{{ note.created_at }}</span><br>{{ note.note }}</div>
        {% else %}
        <p class="text-body-secondary">No notes yet.</p>
        {% endfor %}
        <form method="post" action="/admin/partners/{{ org.id }}/notes" class="row g-2 align-items-end mt-2">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="col"><label class="form-label">Note<textarea name="note" required class="form-control" rows="1"></textarea></label></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Add note</button></div>
        </form>
    </div>
</div>
{% endblock %}
