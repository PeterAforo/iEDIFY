{% extends 'layouts/admin.twig' %}
{% block title %}Programs | iEDIFY Africa{% endblock %}
{% block page_title %}Programs{% endblock %}
{% block admin %}
<div class="card mb-4">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead><tr><th scope="col">Title</th><th scope="col">Slug</th><th scope="col">Status</th><th scope="col">Intakes</th><th scope="col">Updated (UTC)</th></tr></thead>
            <tbody>
                {% for program in programs %}
                <tr>
                    <td><a href="/admin/programs/{{ program.id }}">{{ program.title }}</a></td>
                    <td><code>{{ program.slug }}</code></td>
                    <td><span class="badge text-bg-{{ program.status == 'open' ? 'success' : 'secondary' }}">{{ program.status }}</span></td>
                    <td>{{ program.intakes }}</td>
                    <td>{{ program.updated_at }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-body-secondary">No programs yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card" style="max-width:48rem">
    <div class="card-header"><h3 class="card-title">Create a program</h3></div>
    <form method="post" action="/admin/programs">
        <div class="card-body">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <div class="mb-3"><label for="p-slug" class="form-label">Slug</label><input id="p-slug" name="slug" type="text" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="191" class="form-control"></div>
            <div class="mb-3"><label for="p-title" class="form-label">Title</label><input id="p-title" name="title" type="text" required maxlength="255" class="form-control"></div>
            <div class="mb-3"><label for="p-summary" class="form-label">Summary</label><textarea id="p-summary" name="summary" rows="3" required class="form-control"></textarea></div>
            <div class="mb-3"><label for="p-elig" class="form-label">Eligibility summary</label><textarea id="p-elig" name="eligibility_summary" rows="3" required class="form-control"></textarea></div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Create program</button></div>
    </form>
</div>
{% endblock %}
