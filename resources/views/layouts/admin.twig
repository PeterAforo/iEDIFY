<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{% block title %}Admin | iEDIFY Africa{% endblock %}</title>
    {% for stylesheet in asset_styles('resources/assets/scripts/admin.js') %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}
    <script type="module" src="{{ asset('resources/assets/scripts/admin.js') }}"></script>
    {% block extra_head %}{% endblock %}
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right me-1"></i>View site</a>
                </li>
                <li class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>Administrator
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/account"><i class="bi bi-person me-2"></i>Account</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="/admin/logout" class="px-2">
                                <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
    <aside class="app-sidebar" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a href="/admin" class="brand-link">
                <img class="brand-image" src="{{ chrome.logo_dark_url }}" alt="iEDIFY Africa" width="33" height="15">
                <span>
                    <span class="brand-text">Studio</span>
                    <span class="brand-tag">Content desk</span>
                </span>
            </a>
        </div>
        <div class="sidebar-wrapper">
            <nav class="mt-2" aria-label="Administration">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" data-accordion="false">
                    <li class="nav-item">
                        <a href="/admin" class="nav-link{% if current_path == '/admin' %} active{% endif %}">
                            <i class="nav-icon bi bi-speedometer2"></i><p>Overview</p>
                        </a>
                    </li>
                    <li class="nav-header">CONTENT</li>
                    <li class="nav-item{% if current_path starts with '/admin/content' %} menu-open{% endif %}">
                        <a href="/admin/content" class="nav-link{% if current_path starts with '/admin/content' %} active{% endif %}">
                            <i class="nav-icon bi bi-file-earmark-text"></i>
                            <p>Content <i class="nav-arrow bi bi-chevron-right"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item"><a href="/admin/content" class="nav-link"><i class="nav-icon bi bi-circle"></i><p>All content</p></a></li>
                            <li class="nav-item"><a href="/admin/content?type=page" class="nav-link"><i class="nav-icon bi bi-file-earmark"></i><p>Pages</p></a></li>
                            <li class="nav-item"><a href="/admin/content?type=news" class="nav-link"><i class="nav-icon bi bi-newspaper"></i><p>News &amp; stories</p></a></li>
                            <li class="nav-item"><a href="/admin/content?type=faq" class="nav-link"><i class="nav-icon bi bi-question-circle"></i><p>FAQs</p></a></li>
                            <li class="nav-item"><a href="/admin/content?type=publication" class="nav-link"><i class="nav-icon bi bi-journal-text"></i><p>Publications</p></a></li>
                            <li class="nav-item"><a href="/admin/content?type=event" class="nav-link"><i class="nav-icon bi bi-calendar-event"></i><p>Events</p></a></li>
                            <li class="nav-item"><a href="/admin/content?type=opportunity" class="nav-link"><i class="nav-icon bi bi-briefcase"></i><p>Opportunities</p></a></li>
                            <li class="nav-item"><a href="/admin/content?type=legal" class="nav-link"><i class="nav-icon bi bi-shield-lock"></i><p>Legal pages</p></a></li>
                            <li class="nav-item"><a href="/admin/content/new" class="nav-link"><i class="nav-icon bi bi-plus-circle"></i><p>Add new</p></a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a href="/admin/team" class="nav-link{% if current_path starts with '/admin/team' %} active{% endif %}"><i class="nav-icon bi bi-people"></i><p>Team</p></a></li>
                    <li class="nav-item"><a href="/admin/media" class="nav-link{% if current_path starts with '/admin/media' %} active{% endif %}"><i class="nav-icon bi bi-images"></i><p>Media</p></a></li>
                    <li class="nav-item"><a href="/admin/flags" class="nav-link{% if current_path starts with '/admin/flags' %} active{% endif %}"><i class="nav-icon bi bi-flag"></i><p>Review flags</p></a></li>
                    <li class="nav-item"><a href="/admin/menus" class="nav-link{% if current_path starts with '/admin/menus' %} active{% endif %}"><i class="nav-icon bi bi-list-ul"></i><p>Menus</p></a></li>
                    <li class="nav-item"><a href="/admin/hero" class="nav-link{% if current_path starts with '/admin/hero' %} active{% endif %}"><i class="nav-icon bi bi-card-image"></i><p>Hero</p></a></li>
                    <li class="nav-item"><a href="/admin/settings" class="nav-link{% if current_path starts with '/admin/settings' %} active{% endif %}"><i class="nav-icon bi bi-gear"></i><p>Settings</p></a></li>
                    <li class="nav-header">PROGRAMS</li>
                    <li class="nav-item"><a href="/admin/programs" class="nav-link{% if current_path starts with '/admin/programs' %} active{% endif %}"><i class="nav-icon bi bi-mortarboard"></i><p>Programs</p></a></li>
                    <li class="nav-item"><a href="/admin/applications" class="nav-link{% if current_path starts with '/admin/applications' %} active{% endif %}"><i class="nav-icon bi bi-inbox"></i><p>Applications</p></a></li>
                    <li class="nav-item"><a href="/admin/learning" class="nav-link{% if current_path starts with '/admin/learning' or current_path starts with '/admin/courses' %} active{% endif %}"><i class="nav-icon bi bi-book"></i><p>Learning</p></a></li>
                    <li class="nav-item"><a href="/admin/milestones" class="nav-link{% if current_path starts with '/admin/milestones' %} active{% endif %}"><i class="nav-icon bi bi-check2-square"></i><p>Milestones</p></a></li>
                    <li class="nav-item"><a href="/admin/moderation" class="nav-link{% if current_path starts with '/admin/moderation' %} active{% endif %}"><i class="nav-icon bi bi-shield-check"></i><p>Moderation</p></a></li>
                    <li class="nav-header">OPERATIONS</li>
                    <li class="nav-item"><a href="/admin/funding" class="nav-link{% if current_path starts with '/admin/funding' %} active{% endif %}"><i class="nav-icon bi bi-cash-coin"></i><p>Funding</p></a></li>
                    <li class="nav-item"><a href="/admin/impact" class="nav-link{% if current_path starts with '/admin/impact' %} active{% endif %}"><i class="nav-icon bi bi-graph-up-arrow"></i><p>Impact</p></a></li>
                    <li class="nav-item"><a href="/admin/partners" class="nav-link{% if current_path starts with '/admin/partners' %} active{% endif %}"><i class="nav-icon bi bi-people"></i><p>Partners</p></a></li>
                    <li class="nav-item"><a href="/admin/requests" class="nav-link{% if current_path starts with '/admin/requests' %} active{% endif %}"><i class="nav-icon bi bi-database-down"></i><p>Data requests</p></a></li>
                    <li class="nav-item"><a href="/admin/invitations" class="nav-link{% if current_path starts with '/admin/invitations' %} active{% endif %}"><i class="nav-icon bi bi-envelope-plus"></i><p>Invitations</p></a></li>
                    <li class="nav-item"><a href="/admin/outbox" class="nav-link{% if current_path starts with '/admin/outbox' %} active{% endif %}"><i class="nav-icon bi bi-send"></i><p>Outbox</p></a></li>
                </ul>
            </nav>
        </div>
    </aside>
    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-sm-6">
                        {% if block('page_eyebrow') is defined %}<div class="page-eyebrow">{% block page_eyebrow %}{% endblock %}</div>{% endif %}
                        <h3 class="mb-0">{% block page_title %}Administration{% endblock %}</h3>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-end mb-0">
                            <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                            {% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ block('page_title') }}</li>{% endblock %}
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        <div class="app-content">
            <div class="container-fluid">
                {% if flashes %}
                <div aria-live="polite">
                    {% for type, messages in flashes %}{% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    {% endfor %}{% endfor %}
                </div>
                {% endif %}
                {% block admin %}{% endblock %}
            </div>
        </div>
    </main>
    <footer class="app-footer">
        <div class="float-end d-none d-sm-inline">iEDIFY Africa CMS</div>
        <strong>&copy; {{ "now"|date("Y") }} iEDIFY Africa.</strong> All rights reserved.
    </footer>
</div>
</body>
</html>
