<!doctype html>
<html lang="en" data-bs-theme="light" data-lte-color-mode="off">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{% block title %}Admin sign in | iEDIFY Africa{% endblock %}</title>
    {% for stylesheet in asset_styles('resources/assets/scripts/admin.js') %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}
    <script type="module" src="{{ asset('resources/assets/scripts/admin.js') }}"></script>
</head>
<body class="login-page">
<div class="desk-auth-stage">
    <div class="desk-auth">
        <aside class="desk-auth-brand">
            <img class="desk-auth-logo" src="{{ chrome.logo_dark_url }}" alt="iEDIFY Africa" width="44" height="20">
            <div class="desk-auth-brand-inner">
                <h1 class="desk-auth-wordmark">Welcome back!</h1>
                <p class="desk-auth-tag">To keep the site moving, sign in with your staff account.</p>
                <a class="desk-auth-ghost" href="/">Visit the site</a>
            </div>
        </aside>
        <main class="desk-auth-main">
            <div class="login-box">
                <div class="card">
                    <div class="card-body login-card-body">
                        {% if flashes %}
                            {% for type, messages in flashes %}{% for message in messages %}
                            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                            {% endfor %}{% endfor %}
                        {% endif %}
                        {% block auth %}{% endblock %}
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
</body>
</html>
