<!doctype html>
<html lang="en" data-bs-theme="light" data-lte-color-mode="off">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{% block title %}Admin sign in | iEDIFY Africa{% endblock %}</title>
    {% for stylesheet in asset_styles('resources/assets/scripts/admin.js') %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}
    <script type="module" src="{{ asset('resources/assets/scripts/admin.js') }}"></script>
</head>
<body class="login-page">
<div class="desk-auth">
    <aside class="desk-auth-brand">
        <div class="desk-auth-brand-inner">
            <img class="desk-auth-logo" src="{{ chrome.logo_dark_url }}" alt="iEDIFY Africa" width="44" height="20">
            <div class="desk-auth-wordmark">iEDIFY <em>Africa</em> Studio</div>
            <p class="desk-auth-tag">The content desk — pages, people, programs and media for iEDIFY Africa.</p>
            <ul class="desk-auth-points">
                <li><i class="bi bi-check2-circle"></i>Draft, review and publish content</li>
                <li><i class="bi bi-check2-circle"></i>Manage the team roster and media</li>
                <li><i class="bi bi-check2-circle"></i>Track programs, applications and mail</li>
            </ul>
        </div>
        <div class="desk-auth-band" aria-hidden="true"></div>
    </aside>
    <main class="desk-auth-main">
        <div class="login-box">
            <div class="card">
                <div class="card-body login-card-body">
                    {% if flashes %}
                        {% for type, messages in flashes %}{% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        {% endfor %}{% endfor %}
                    {% endif %}
                    {% block auth %}{% endblock %}
                </div>
            </div>
        </div>
    </main>
</div>
</body>
</html>
