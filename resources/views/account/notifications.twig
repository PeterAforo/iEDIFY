{% extends 'layouts/base.twig' %}
{% block title %}Notifications | iEDIFY Africa{% endblock %}
{% block content %}
<section class="container auth-page">
    <h1>Notifications</h1>
    <ul class="notification-list">
        {% for notification in notifications %}
        <li class="notification{% if not notification.read_at %} notification-unread{% endif %}">
            <a href="{{ notification.target_path }}">{{ notification.title }}</a>
            <span class="field-hint">{{ notification.type }} · {{ notification.created_at }}</span>
            {% if not notification.read_at %}
            <form method="post" action="/account/notifications/read" class="inline-form">
                <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
                <input type="hidden" name="id" value="{{ notification.id }}">
                <button type="submit" class="button-secondary">Mark read</button>
            </form>
            {% endif %}
        </li>
        {% else %}
        <li>No notifications yet.</li>
        {% endfor %}
    </ul>
    <h2>Email preferences</h2>
    <p class="field-hint">Choose which notifications are also emailed to you. In-app notifications always appear here.</p>
    <form method="post" action="/account/notifications/preferences" class="stacked-form">
        <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
        {% for scope in scopes %}
        <label><input type="checkbox" name="scope_{{ scope }}" value="1"{% if preferences[scope] is not defined or preferences[scope] %} checked{% endif %}> {{ scope|capitalize }}</label>
        {% endfor %}
        <button type="submit" class="button-secondary">Save preferences</button>
    </form>
    <p><a href="/account">Back to account</a></p>
</section>
{% endblock %}
