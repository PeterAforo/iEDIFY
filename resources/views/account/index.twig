{% extends 'layouts/base.twig' %}
{% block title %}Your account | iEDIFY Africa{% endblock %}
{% block content %}
<section class="container auth-page">
    <h1>Your account</h1>
    {% if not actor.verified %}
    <div class="status-panel" role="status">
        <h2>Verify your email</h2>
        <p>Confirm your email address to use applications, programs and community features.</p>
        <form method="post" action="/account/email/resend">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <button type="submit" class="button-secondary">Resend verification email</button>
        </form>
    </div>
    {% endif %}
    <dl class="account-details">
        <dt>Name</dt><dd>{{ user.name }}</dd>
        <dt>Email</dt><dd>{{ user.email }}</dd>
        <dt>Member since</dt><dd>{{ user.created_at|date('j F Y', 'Africa/Accra') }}</dd>
    </dl>
    <h2>Your activity</h2>
    <ul>
        <li><a href="/account/applications">My applications</a></li>
        <li><a href="/learn">My learning</a></li>
        <li><a href="/account/mentoring">Mentoring</a></li>
        <li><a href="/account/milestones">Milestones</a></li>
        <li><a href="/community">Community</a></li>
        <li><a href="/account/notifications">Notifications</a></li>
    </ul>
    <h2>Security</h2>
    <p><a href="/account/security">Manage multi-factor authentication</a></p>
    <h2>Your data</h2>
    <p>Request a copy of your personal data or ask for your account to be deleted. Requests are reviewed by the team; audit and financial records are retained as required.</p>
    <div class="action-row">
        <form method="post" action="/account/data-request">
            <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
            <button type="submit" name="type" value="export" class="button-secondary">Request data export</button>
            <button type="submit" name="type" value="deletion" class="button-secondary">Request account deletion</button>
        </form>
    </div>
    {% if actor.privileged %}<p><a href="/admin">Go to the administration area</a></p>{% endif %}
</section>
{% endblock %}
