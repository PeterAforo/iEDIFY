{% extends 'layouts/base.twig' %}
{% block title %}Enable multi-factor authentication | iEDIFY Africa{% endblock %}
{% block content %}
<section class="container auth-page">
    <h1>Enable multi-factor authentication</h1>
    <p class="auth-lead">Add this account to your authenticator app, then enter the six-digit code it shows.</p>
    <div class="field">
        <label for="uri">Setup link</label>
        <input id="uri" type="text" readonly value="{{ uri }}" onclick="this.select()">
    </div>
    <form method="post" action="/account/security/mfa/confirm" class="auth-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf.token() }}">
        <div class="field">
            <label for="code">Authentication code</label>
            <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" required autocomplete="one-time-code" maxlength="6">
        </div>
        <button type="submit" class="button-primary">Confirm and enable</button>
    </form>
</section>
{% endblock %}
