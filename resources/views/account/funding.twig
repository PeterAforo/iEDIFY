{% extends 'layouts/base.twig' %}
{% block title %}My funding requests | iEDIFY Africa{% endblock %}
{% block content %}
<div class="container public-page">
<header class="page-header">
    <p class="eyebrow">Account</p>
    <h1>My funding requests</h1>
</header>
<div class="table-scroll">
<table class="admin-table">
    <thead><tr><th scope="col">Request</th><th scope="col">Round</th><th scope="col">Requested</th><th scope="col">Awarded</th><th scope="col">Status</th></tr></thead>
    <tbody>
        {% for request in requests %}
        <tr>
            <td>{{ request.title }}</td>
            <td>{{ request.round_title }}</td>
            <td>{{ request.requested_amount }} {{ request.currency }}</td>
            <td>{% if request.awarded_amount is not null %}{{ request.awarded_amount }} {{ request.currency }}{% else %}—{% endif %}</td>
            <td>{{ request.status }}</td>
        </tr>
        {% else %}
        <tr><td colspan="5">You have no funding requests.</td></tr>
        {% endfor %}
    </tbody>
</table>
</div>
</div>
{% endblock %}
