{% extends 'layouts/base.twig' %}
{% import 'public/_sections.twig' as ui %}
{% import 'partials/icons.twig' as icons %}
{% import 'partials/africa-defs.twig' as africa %}
{% set p = info.slots|default({}) %}
{% block title %}Community | iEDIFY Africa{% endblock %}
{% block content %}
<article class="home">

    {# ---------- Hero band ---------- #}
    <section class="about-hero" aria-labelledby="community-title">
        <svg class="about-hero-shape" viewBox="{{ africa.viewbox() }}" aria-hidden="true" focusable="false"><use href="#africa-shape"/></svg>
        <svg class="about-hero-dots" viewBox="{{ africa.viewbox() }}" aria-hidden="true" focusable="false"><use href="#africa-shape" fill="url(#africa-dots)"/></svg>
        <span class="float-dot dot-sun about-hero-dot-a" aria-hidden="true"></span>
        <span class="float-dot dot-leaf about-hero-dot-b" aria-hidden="true"></span>
        <div class="container about-hero-inner">
            <p class="about-eyebrow-light">{{ p.intro.heading|default('iEDIFY Africa Community') }}</p>
            <h1 id="community-title" class="about-title">{{ p.intro.title|default('Where African changemakers connect') }}</h1>
            {% if p.intro.lead|default('') %}<p class="about-hero-lead">{{ p.intro.lead }}</p>{% endif %}
            {% if not actor and p.intro.ctas|default([]) %}
            <div class="btn-row community-hero-ctas">
                {% for cta in p.intro.ctas %}
                <a class="btn-pill {{ loop.first ? 'btn-sun' : 'btn-outline-light' }}" href="{{ cta.url }}">{{ cta.label }}{% if loop.first %} <span aria-hidden="true">&rarr;</span>{% endif %}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </section>

    {# ---------- Inside the hub: photo + feature pills + gallery strip ---------- #}
    {% if p.hub is defined %}
    {% set hub_img = p.hub.images|default([])|first|default(null) %}
    <section class="home-section" aria-labelledby="hub-heading">
        <div class="container">
            <header class="home-section-head" data-reveal>
                <p class="home-eyebrow">{{ p.hub.heading }}</p>
                <h2 id="hub-heading">{{ p.hub.title }}</h2>
                {% if p.hub.lead %}<p>{{ p.hub.lead }}</p>{% endif %}
            </header>
            <div class="community-landing-grid">
                {% if hub_img and media[hub_img.media_id]|default(null) %}
                {% set m = media[hub_img.media_id] %}
                <figure class="community-photo" data-reveal>
                    <img src="{{ m.url }}" alt="{{ hub_img.alt }}" loading="lazy"{% if m.width and m.height %} width="{{ m.width }}" height="{{ m.height }}"{% endif %}>
                </figure>
                {% endif %}
                <div class="community-feature-list" data-reveal-group>
                    {% for set in p.hub.cards|default([]) %}
                        {% for item in set %}
                        <article class="about-pill" role="listitem">
                            <span class="about-pill-icon about-pill-icon-{{ cycle(['clay', 'forest'], loop.index0) }}">{{ icons.icon(icons.pick(item.title)) }}</span>
                            <div class="about-pill-body">
                                <h3>{{ item.title }}</h3>
                                <p>{{ item.text }}</p>
                            </div>
                        </article>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
            {% if p.hub.gallery|default([]) %}
            <div class="community-gallery" data-reveal-group>
                {% for shot in p.hub.gallery %}
                    {% if media[shot.media_id]|default(null) %}
                    {% set m = media[shot.media_id] %}
                    <figure class="community-gallery-item">
                        <img src="{{ m.url }}" alt="{{ shot.alt }}" loading="lazy"{% if m.width and m.height %} width="{{ m.width }}" height="{{ m.height }}"{% endif %}>
                    </figure>
                    {% endif %}
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    {# ---------- How to join: numbered steps ---------- #}
    {% if p.steps is defined %}
    <section class="home-section feature-band" aria-labelledby="steps-heading">
        <div class="container">
            <header class="home-section-head" data-reveal>
                <p class="home-eyebrow">{{ p.steps.heading }}</p>
                <h2 id="steps-heading">{{ p.steps.title }}</h2>
                {% if p.steps.lead %}<p>{{ p.steps.lead }}</p>{% endif %}
            </header>
            <div class="step-grid" data-reveal-group>
                {% for set in p.steps.cards|default([]) %}
                    {% for item in set %}
                    <article class="step-card">
                        <span class="step-num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                        <h3>{{ item.title }}</h3>
                        <p>{{ item.text }}</p>
                    </article>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {# ---------- Join CTA ---------- #}
    <section class="home-section home-theory" aria-label="Join the community">
        <div class="container">
            <div class="theory-banner shift-banner" data-reveal>
                {% if media[9] is defined %}
                <img class="about-story-bg" src="{{ media[9].url }}" alt="" loading="lazy" data-parallax>
                {% endif %}
                <div>
                    {% if actor %}
                        <p class="about-eyebrow-light">Members-only space</p>
                        <h2>Almost there</h2>
                        <p>Your account does not have community membership yet. Community access is granted through program participation — apply to a program to join the hub.</p>
                        <div class="btn-row">
                            <a class="btn-pill btn-sun" href="/programs">Explore programs <span aria-hidden="true">&rarr;</span></a>
                        </div>
                    {% else %}
                        <p class="about-eyebrow-light">{{ p.join.heading|default('Members-only space') }}</p>
                        <h2>{{ p.join.title|default('Join the conversation') }}</h2>
                        {% if p.join.lead|default('') %}
                        <p>{{ p.join.lead }}</p>
                        {% else %}
                        <p>Member groups, the directory and discussions are available to verified participants and alumni.</p>
                        {% endif %}
                        <div class="btn-row">
                            {% for cta in p.join.ctas|default([]) %}
                            <a class="btn-pill {{ loop.first ? 'btn-sun' : 'btn-outline-light' }}" href="{{ cta.url }}">{{ cta.label }}{% if loop.first %} <span aria-hidden="true">&rarr;</span>{% endif %}</a>
                            {% else %}
                            <a class="btn-pill btn-sun" href="/sign-up">Create free account <span aria-hidden="true">&rarr;</span></a>
                            <a class="btn-pill btn-outline-light" href="/sign-in">Sign in to access</a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    {% if info.leftover|default([]) %}
    <section class="home-section">
        <div class="container page-body">{{ ui.render(info.leftover, media) }}</div>
    </section>
    {% endif %}
</article>
{% endblock %}
